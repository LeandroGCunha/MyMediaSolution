@page "/carrinho"
@using MyMedia.Client.RCL.Services
@using MyMedia.Client.RCL.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json

@inject CarrinhoService CarrinhoSvc
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<div class="container mt-5">
    <h2 class="mb-4"><i class="bi bi-cart3"></i> O meu Carrinho</h2>

    @if (itens.Count == 0)
    {
        <div class="alert alert-warning text-center p-5">
            <h4>O seu carrinho está vazio!</h4>
            <p>Vá dar uma volta pelo catálogo.</p>
            <a href="/" class="btn btn-primary mt-3">Ir para a Loja</a>
        </div>
    }
    else
    {
        <div class="row">
            @* --- COLUNA DA ESQUERDA: LISTA DE PRODUTOS --- *@
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Produto</th>
                                        <th>Preço Un.</th>
                                        <th style="width: 140px;">Quantidade</th>
                                        <th>Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in itens)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.Produto.ImagemUrl))
                                                    {
                                                        @* 👇 AQUI ESTÁ A CORREÇÃO DA IMAGEM *@
                                                        <img src="@GetFullImageUrl(item.Produto.ImagemUrl)" width="50" class="rounded me-2" style="object-fit: cover; height: 50px;">
                                                    }
                                                    <div>
                                                        <span class="fw-bold d-block text-truncate" style="max-width: 150px;">@item.Produto.Titulo</span>
                                                        <small class="text-muted" style="font-size: 0.75rem;">
                                                            Stock: @item.Produto.Stock un.
                                                        </small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@item.Produto.PrecoFinal.ToString("C")</td>
                                            <td>
                                                <div class="input-group input-group-sm">
                                                    <input type="number"
                                                           class="form-control text-center"
                                                           min="1"
                                                           max="@item.Produto.Stock"
                                                           value="@item.Quantidade"
                                                           @onchange="@(e => AtualizarQtd(item, e.Value))" />
                                                </div>
                                                @if (item.Quantidade >= item.Produto.Stock)
                                                {
                                                    <small class="text-danger fw-bold" style="font-size: 0.7rem;">
                                                        Máx. atingido!
                                                    </small>
                                                }
                                            </td>
                                            <td class="fw-bold text-success">
                                                @((item.Produto.PrecoFinal * item.Quantidade).ToString("C"))
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Remover(item)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            @* --- COLUNA DA DIREITA: RESUMO E CHECKOUT --- *@
            <div class="col-md-4 mt-4 mt-md-0">
                <div class="card shadow border-primary sticky-top" style="top: 80px; z-index: 1;">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Resumo</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <span>Total Itens:</span>
                            <strong>@CarrinhoSvc.ContarItens()</strong>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fs-4">Total a Pagar:</span>
                            <strong class="fs-4 text-primary">@CarrinhoSvc.Total().ToString("C")</strong>
                        </div>

                        <AuthorizeView>
                            <Authorized>
                                @* Se estiver logado, verificamos se é Cliente *@
                                @if (context.User.IsInRole("Cliente"))
                                {
                                    <button class="btn btn-success w-100 btn-lg" @onclick="IrParaCheckout">
                                        <span>Ir para Pagamento <i class="bi bi-arrow-right"></i></span>
                                    </button>
                                }
                                else
                                {
                                    @* Se for Fornecedor, Admin, etc., mostramos aviso *@
                                    <div class="alert alert-warning text-center mb-0">
                                        <i class="bi bi-exclamation-triangle-fill"></i><br />
                                        Apenas contas de <strong>Cliente</strong> podem efetuar compras.
                                    </div>
                                }
                            </Authorized>
                            <NotAuthorized>
                                @* Se não estiver logado *@
                                <button class="btn btn-warning w-100 btn-lg" @onclick="IrParaLogin">
                                    🔒 Login para Comprar
                                </button>
                                <small class="text-muted text-center d-block mt-2">
                                    Precisa de conta para finalizar a encomenda.
                                </small>
                            </NotAuthorized>
                        </AuthorizeView>

                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<CarrinhoItem> itens = new();

    protected override void OnInitialized()
    {
        itens = CarrinhoSvc.GetItems();
        CarrinhoSvc.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CarrinhoSvc.OnChange -= StateHasChanged;
    }

    private void Remover(CarrinhoItem item)
    {
        CarrinhoSvc.Remover(item.Produto);
    }

    private void AtualizarQtd(CarrinhoItem item, object? valorInput)
    {
        if (int.TryParse(valorInput?.ToString(), out int novaQtd))
        {
            CarrinhoSvc.AtualizarQuantidade(item.Produto, novaQtd);
        }
    }

    private void IrParaLogin()
    {
        Navigation.NavigateTo("/login");
    }

    private void IrParaCheckout()
    {
        Navigation.NavigateTo("/checkout");
    }

    // 👇 FUNÇÃO MÁGICA PARA AS IMAGENS (Mobile + Web)
    private string GetFullImageUrl(string imagePath)
    {
        if (string.IsNullOrEmpty(imagePath)) return "";
        var baseUrl = Http.BaseAddress?.ToString() ?? "";
        var urlFinal = $"{baseUrl.TrimEnd('/')}/{imagePath.TrimStart('/')}";
        return $"{urlFinal}?v={DateTime.Now.Ticks}";
    }
}