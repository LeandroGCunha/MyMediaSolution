@page "/carrinho"
@using MyMedia.Client.RCL.Services
@using MyMedia.Client.RCL.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json

@inject CarrinhoService CarrinhoSvc
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider

<div class="container mt-4 mb-5">
    <h3 class="mb-4 fw-bold"><i class="bi bi-bag"></i> O meu Carrinho</h3>

    @if (itens.Count == 0)
    {
        <div class="text-center py-5">
            <div class="mb-3">
                <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
            </div>
            <h4 class="text-muted">O seu carrinho está vazio!</h4>
            <p class="text-muted mb-4">Parece que ainda não adicionou nada.</p>
            <a href="/" class="btn btn-primary rounded-pill px-4">Ir para a Loja</a>
        </div>
    }
    else
    {
        <div class="row g-4">

            @* --- COLUNA ESQUERDA: LISTA DE PRODUTOS (LAYOUT CARD) --- *@
            <div class="col-lg-8">

                @foreach (var item in itens)
                {
                    <div class="card mb-3 border-0 shadow-sm overflow-hidden">
                        <div class="row g-0">

                            @* 1. IMAGEM (Ocupa 4 colunas no mobile, 2 no PC) *@
                            <div class="col-4 col-md-2 bg-light d-flex align-items-center justify-content-center position-relative">
                                @if (!string.IsNullOrEmpty(item.Produto.ImagemUrl))
                                {
                                    <img src="@GetFullImageUrl(item.Produto.ImagemUrl)"
                                         class="img-fluid w-100 h-100"
                                         style="object-fit: cover; min-height: 120px; max-height: 150px;">
                                }
                                else
                                {
                                    <i class="bi bi-camera text-muted fs-2"></i>
                                }
                            </div>

                            @* 2. DETALHES DO PRODUTO *@
                            <div class="col-8 col-md-10">
                                <div class="card-body h-100 d-flex flex-column justify-content-between">

                                    @* Cabeçalho: Titulo e Preço Unitário *@
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="card-title fw-bold mb-1 text-truncate-2">@item.Produto.Titulo</h6>
                                            <small class="text-muted">Un: @item.Produto.PrecoFinal.ToString("C")</small>
                                        </div>
                                        @* Botão Remover (Topo direito no mobile) *@
                                        <button class="btn btn-link text-danger p-0 text-decoration-none" @onclick="() => Remover(item)">
                                            <i class="bi bi-trash fs-5"></i>
                                        </button>
                                    </div>

                                    @* Rodapé do Item: Quantidade e Total *@
                                    <div class="d-flex justify-content-between align-items-end mt-auto">

                                        @* Controlador de Quantidade (+/-) *@
                                        <div class="d-flex flex-column">
                                            <small class="text-muted mb-1" style="font-size: 0.75rem;">Quantidade</small>
                                            <div class="input-group input-group-sm" style="width: 110px;">
                                                <button class="btn btn-outline-secondary" type="button"
                                                        @onclick="() => AlterarQtdBotao(item, -1)">
                                                    -
                                                </button>

                                                <input type="text" class="form-control text-center bg-white" readonly value="@item.Quantidade" />

                                                <button class="btn btn-outline-secondary" type="button"
                                                        @onclick="() => AlterarQtdBotao(item, 1)">
                                                    +
                                                </button>
                                            </div>
                                            @if (item.Quantidade >= item.Produto.Stock)
                                            {
                                                <small class="text-danger fw-bold mt-1" style="font-size: 0.65rem;">Máx. stock!</small>
                                            }
                                        </div>

                                        @* Preço Total do Item *@
                                        <div class="text-end">
                                            <small class="text-muted d-block" style="font-size: 0.75rem;">Total</small>
                                            <span class="fw-bold text-primary fs-5">
                                                @((item.Produto.PrecoFinal * item.Quantidade).ToString("C"))
                                            </span>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* --- COLUNA DIREITA: RESUMO (FIXO) --- *@
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm bg-white sticky-top" style="top: 80px; 80px; z-index: 1;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">Resumo do Pedido</h5>

                        <div class="d-flex justify-content-between mb-2 text-muted">
                            <span>Produtos (@CarrinhoSvc.ContarItens())</span>
                            <span>Calculado no fim</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4 text-muted">
                            <span>Envio</span>
                            <span class="text-success">Grátis</span>
                        </div>

                        <hr class="my-3">

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-5 fw-bold">Total</span>
                            <span class="fs-4 fw-bold text-dark">@CarrinhoSvc.Total().ToString("C")</span>
                        </div>

                        <AuthorizeView>
                            <Authorized>
                                @if (context.User.IsInRole("Cliente"))
                                {
                                    <button class="btn btn-dark w-100 py-3 rounded-3 fw-bold shadow-sm" @onclick="IrParaCheckout">
                                        Finalizar Compra
                                    </button>
                                }
                                else
                                {
                                    <div class="alert alert-warning text-center small mb-0">
                                        Apenas Clientes podem comprar.
                                    </div>
                                }
                            </Authorized>
                            <NotAuthorized>
                                <button class="btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm" @onclick="IrParaLogin">
                                    Login para Comprar
                                </button>
                            </NotAuthorized>
                        </AuthorizeView>

                        <div class="mt-4 text-center">
                            <a href="/" class="text-decoration-none text-muted small">
                                <i class="bi bi-arrow-left me-1"></i> Continuar a comprar
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

@code {
    private List<CarrinhoItem> itens = new();

    protected override void OnInitialized()
    {
        itens = CarrinhoSvc.GetItems();
        CarrinhoSvc.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CarrinhoSvc.OnChange -= StateHasChanged;
    }

    private void Remover(CarrinhoItem item)
    {
        CarrinhoSvc.Remover(item.Produto);
    }

    // Função auxiliar para os botões de + e -
    private void AlterarQtdBotao(CarrinhoItem item, int delta)
    {
        int novaQtd = item.Quantidade + delta;
        if (novaQtd < 1) return; // Não deixa ir para zero por aqui
        if (novaQtd > item.Produto.Stock) return; // Não passa do stock

        CarrinhoSvc.AtualizarQuantidade(item.Produto, novaQtd);
    }

    private void IrParaLogin() => Navigation.NavigateTo("/login");
    private void IrParaCheckout() => Navigation.NavigateTo("/checkout");

    private string GetFullImageUrl(string imagePath)
    {
        if (string.IsNullOrEmpty(imagePath)) return "";
        var baseUrl = Http.BaseAddress?.ToString() ?? "";
        var urlFinal = $"{baseUrl.TrimEnd('/')}/{imagePath.TrimStart('/')}";
        return $"{urlFinal}?v={DateTime.Now.Ticks}";
    }
}