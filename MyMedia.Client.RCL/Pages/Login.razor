@page "/login"

@inject NavigationManager Nav

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h3>?? Entrar</h3>
                </div>
                <div class="card-body">

                    @* MENSAGEM DE ERRO *@
                    @* Se a URL tiver ?error=..., mostramos o alerta *@
                    @if (!string.IsNullOrEmpty(ErrorCode))
                    {
                        @if (ErrorCode == "pendente")
                        {
                            <div class="alert alert-warning text-center">
                                <i class="bi bi-hourglass-split"></i><br />
                                <strong>Conta Pendente!</strong><br />
                                O seu registo aguarda aprovação de um administrador.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger text-center">
                                Utilizador ou password incorretos.
                            </div>
                        }
                    }

                    @* ?? AQUI ESTÁ A MUDANÇA CRÍTICA ?? *@
                    @* 1. Usamos <form> normal (não EditForm) *@
                    @* 2. Action="/account/login" aponta para o Program.cs *@
                    @* 3. Method="post" é obrigatório *@
                    <form action="/account/login" method="post">

                        <div class="mb-3">
                            <label class="form-label">Email / Utilizador</label>
                            @* O 'name="email"' tem de bater certo com o Program.cs *@
                            <input name="email" type="text" class="form-control" placeholder="Ex: admin" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Palavra-Passe</label>
                            @* O 'name="password"' tem de bater certo com o Program.cs *@
                            <input name="password" type="password" class="form-control" placeholder="******" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Entrar
                        </button>

                    </form>

                    <div class="mt-3 text-center">
                        <a href="/registar">Criar Conta</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Isto serve apenas para ler se houve erro no login
    // O Program.cs redireciona para /login?error=true se falhar
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorCode { get; set; }
}