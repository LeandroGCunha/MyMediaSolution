@page "/login"
@using MyMedia.Client.RCL.Models
@using MyMedia.Client.RCL.Services
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.Extensions.Configuration

@inject NavigationManager Nav
@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@inject IConfiguration Config

<div class="container mt-5">



    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center">
                    <h3>🔐 Entrar</h3>
                </div>
                <div class="card-body">

                    @if (!string.IsNullOrEmpty(mensagemErro))
                    {
                        <div class="alert alert-danger text-center">@mensagemErro</div>
                    }

                    @* --- WEB (FORMULÁRIO) --- *@
                    @if (!IsMobile)
                    {
                        <form action="/account/login" method="post">
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input name="email" type="text" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <input name="password" type="password" class="form-control" required />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Entrar (Web)</button>
                        </form>
                    }

                    @* --- MOBILE (C#) --- *@
                    @if (IsMobile)
                    {
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input @bind="emailModel" class="form-control" placeholder="admin" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input @bind="passwordModel" type="password" class="form-control" placeholder="******" />
                        </div>
                        <button class="btn btn-primary w-100" @onclick="LoginMobile">Entrar (Mobile)</button>
                    }

                    <div class="mt-3 text-center">
                        <a href="/registar">Criar Conta</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    bool IsMobile = false;
    string emailModel = "";
    string passwordModel = "";
    string mensagemErro = "";

    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorCode { get; set; }

    protected override void OnInitialized()
    {
        // 1. TENTATIVA PELA CONFIGURAÇÃO (MauiProgram)
        var configMobile = Config["IsMobile"];

        // Se a config tiver "true", ativa o modo Mobile
        if (!string.IsNullOrEmpty(configMobile) && configMobile == "true")
        {
            IsMobile = true;
        }

        // 2. SEGURANÇA EXTRA: Se falhar a config, tenta detetar o sistema operativo
        // (Isto ajuda no Windows se a config falhar)
#if ANDROID || IOS || MACCATALYST || WINDOWS
            // Se estivermos a compilar nativamente, força true,
            // a menos que estejas a correr o projeto WEB no PC.
             IsMobile = true;
#endif

        if (ErrorCode == "pendente") mensagemErro = "Conta pendente.";
        if (ErrorCode == "credenciais_invalidas") mensagemErro = "Dados inválidos.";
    }

    async Task LoginMobile()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", new { UserName = emailModel, Password = passwordModel });

            if (response.IsSuccessStatusCode)
            {
                var userDto = await response.Content.ReadFromJsonAsync<LoginResponseDto>();
                if (AuthProvider is CustomAuthStateProvider customProvider)
                {
                    customProvider.NotifyLogin(userDto);
                }
                Nav.NavigateTo("/");
            }
            else
            {
                mensagemErro = "Erro no login mobile.";
            }
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro: " + ex.Message;
        }
    }
}