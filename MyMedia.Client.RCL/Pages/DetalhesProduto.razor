@page "/produto/{id:int}"
@using MyMedia.Data.Entities
@using MyMedia.Client.RCL.Services
@inject ClientProdutoService ProdutoService
@inject NavigationManager Navigation
@inject CarrinhoService Carrinho
@inject HttpClient Http

<div class="container mt-5">
    @if (produto == null)
    {
        <div class="alert alert-info">A carregar detalhes...</div>
    }
    else
    {
        <div class="card shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h3 class="m-0">@produto.Titulo</h3>
                <span class="badge bg-light text-dark">@produto.Categoria?.Nome</span>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 text-center mb-3">
                        @if (!string.IsNullOrEmpty(produto.ImagemUrl))
                        {
                            @* 👇 USAR A FUNÇÃO AQUI *@
                            <img src="@GetFullImageUrl(produto.ImagemUrl)"
                                 class="img-fluid rounded border shadow-sm"
                                 style="max-height: 400px; width: 100%; object-fit: cover;"
                                 alt="@produto.Titulo" />
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 300px; border-radius: 10px;">
                                <div class="text-center">
                                    <i class="bi bi-camera" style="font-size: 4rem;"></i>
                                    <p class="mt-2">Sem Imagem</p>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="col-md-8">
                        <h4 class="text-success mb-3 fw-bold display-6">@produto.PrecoFinal.ToString("C")</h4>
                        <hr />
                        <h5>Descrição:</h5>
                        <p class="text-muted" style="white-space: pre-line;">
                            @(string.IsNullOrEmpty(produto.Descricao) ? "Sem descrição disponível." : produto.Descricao)
                        </p>

                        <div class="mt-5">
                            <button class="btn btn-success btn-lg me-2" @onclick="AdicionarAoCarrinho">
                                <i class="bi bi-cart-plus"></i> Adicionar ao Carrinho
                            </button>

                            <button class="btn btn-outline-secondary btn-lg" @onclick="Voltar">
                                Voltar à Loja
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer text-muted">
                Stock disponível: <strong>@produto.Stock</strong> unidades
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Produto? produto;

    protected override async Task OnInitializedAsync()
    {
        produto = await ProdutoService.GetProdutoByIdAsync(Id);
    }

    private void AdicionarAoCarrinho()
    {
        if (produto != null)
        {
            Carrinho.Adicionar(produto);
        }
    }

    private void Voltar()
    {
        Navigation.NavigateTo("/");
    }

    // 👇 FUNÇÃO MÁGICA PARA AS IMAGENS
    private string GetFullImageUrl(string imagePath)
    {
        if (string.IsNullOrEmpty(imagePath)) return "";
        var baseUrl = Http.BaseAddress?.ToString() ?? "";
        var urlFinal = $"{baseUrl.TrimEnd('/')}/{imagePath.TrimStart('/')}";
        return $"{urlFinal}?v={DateTime.Now.Ticks}";
    }
}