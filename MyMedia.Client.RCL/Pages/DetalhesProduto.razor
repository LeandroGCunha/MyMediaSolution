@page "/produto/{id:int}"
@using MyMedia.Data.Entities
@using MyMedia.Client.RCL.Services
@inject ClientProdutoService ProdutoService
@inject NavigationManager Navigation
@inject CarrinhoService Carrinho
@inject HttpClient Http

@* --- ESTILOS EXCLUSIVOS DESTA PÁGINA --- *@
<style>
    /* Cor Dourada/Amarela da Marca */
    .text-gold {
        color: #ffc107;
    }

    .bg-gold {
        background-color: #ffc107;
        color: #000;
    }

    /* Botão Adicionar ao Carrinho (Estilo App) */
    .btn-cart-premium {
        background-color: #ffc107;
        color: #1a1a1a;
        font-weight: 800;
        border: none;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .btn-cart-premium:hover {
            background-color: #e0a800;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 193, 7, 0.4);
        }

    /* Botão Voltar (Escuro) */
    .btn-back-dark {
        background-color: transparent;
        border: 2px solid #343a40;
        color: #343a40;
        font-weight: 600;
    }

        .btn-back-dark:hover {
            background-color: #343a40;
            color: #fff;
        }

    /* Badge de Categoria */
    .badge-category {
        background-color: #1a1a1a;
        color: #ffc107;
        font-size: 0.8rem;
        padding: 0.5em 1em;
        letter-spacing: 1px;
    }

    /* Preço Gigante */
    .price-display {
        font-family: 'Segoe UI', sans-serif;
        font-weight: 900;
        color: #1a1a1a;
    }
</style>

<div class="container mt-4 mb-5">

    @* Botão de Voltar Discreto no Topo *@
    <div class="mb-3">
        <a href="/" class="text-decoration-none text-muted d-inline-flex align-items-center" style="transition: 0.2s;">
            <i class="bi bi-arrow-left me-2"></i> Voltar ao catálogo
        </a>
    </div>

    @if (produto == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="mt-2 text-muted">A carregar detalhes...</p>
        </div>
    }
    else
    {
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden bg-white">
            <div class="card-body p-0">
                <div class="row g-0">

                    @* --- COLUNA ESQUERDA: IMAGEM --- *@
                    <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4 position-relative">
                        @if (!string.IsNullOrEmpty(produto.ImagemUrl))
                        {
                            <img src="@GetFullImageUrl(produto.ImagemUrl)" class="img-fluid rounded-3 shadow-sm"
                                 style="max-height: 450px; width: 100%; object-fit: contain; mix-blend-mode: multiply;"
                                 alt="@produto.Titulo" />
                        }
                        else
                        {
                            <div class="text-center text-muted opacity-50">
                                <i class="bi bi-camera-fill" style="font-size: 5rem;"></i>
                                <p>Sem imagem</p>
                            </div>
                        }

                        @* Badge de Stock Flutuante *@
                        @if (produto.Stock > 0)
                        {
                            <div class="position-absolute top-0 start-0 m-3 badge bg-success shadow-sm">
                                <i class="bi bi-check-circle me-1"></i> Em Stock
                            </div>
                        }
                        else
                        {
                            <div class="position-absolute top-0 start-0 m-3 badge bg-danger shadow-sm">
                                <i class="bi bi-x-circle me-1"></i> Esgotado
                            </div>
                        }
                    </div>

                    @* --- COLUNA DIREITA: DETALHES --- *@
                    <div class="col-md-7 p-4 p-md-5 d-flex flex-column">

                        <div class="mb-auto">
                            @* Categoria *@
                            <span class="badge rounded-pill badge-category mb-2">
                                @(produto.Categoria?.Nome?.ToUpper() ?? "GERAL")
                            </span>

                            @* Título *@
                            <h2 class="fw-bold text-dark display-6 mb-2">@produto.Titulo</h2>

                            @* 👇 MOSTRAR O VENDEDOR (NOVA SECÇÃO) 👇 *@
                            <div class="d-flex align-items-center mb-3">
                                @if (produto.Fornecedor != null)
                                {
                                    // É um Vendedor Parceiro
                                    <span class="text-muted small me-2">Vendido por:</span>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-person-check-fill text-primary me-1"></i>
                                        @produto.Fornecedor.NomeCompleto
                                    </span>
                                }
                                else
                                {
                                    // É a Loja (Admin)
                                    <span class="text-muted small me-2">Vendido e enviado por:</span>
                                    <span class="badge bg-dark text-warning border border-warning">
                                        <i class="bi bi-patch-check-fill me-1"></i>
                                        MyMedia Oficial
                                    </span>
                                }
                            </div>

                            @* Preço *@
                            <h3 class="price-display display-5 mb-4">
                                @produto.PrecoFinal.ToString("C")
                            </h3>

                            <hr class="text-muted opacity-25" />

                            @* Descrição *@
                            <h6 class="fw-bold text-uppercase text-muted small mb-2">Sobre este produto</h6>
                            <p class="text-secondary" style="line-height: 1.6; font-size: 1rem;">
                                @(string.IsNullOrEmpty(produto.Descricao) ? "Sem descrição disponível." : produto.Descricao)
                            </p>
                        </div>

                        @* Área de Ação (Baixo) *@
                        <div class="mt-4 pt-3">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <small class="text-muted fw-bold">Disponibilidade:</small>
                                <span class="text-dark fw-bold">@produto.Stock unidades</span>
                            </div>

                            <div class="d-grid gap-2 d-md-flex">
                                <button class="btn btn-cart-premium btn-lg flex-grow-1 py-3 rounded-3 shadow-sm"
                                        @onclick="AdicionarAoCarrinho"
                                        disabled="@(produto.Stock <= 0)">
                                    @if (produto.Stock > 0)
                                    {
                                        <span>ADICIONAR AO CARRINHO <i class="bi bi-bag-plus-fill ms-2"></i></span>
                                    }
                                    else
                                    {
                                        <span>INDISPONÍVEL</span>
                                    }
                                </button>

                                <button class="btn btn-back-dark btn-lg px-4 rounded-3" @onclick="Voltar" title="Voltar">
                                    <i class="bi bi-arrow-return-left"></i>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Produto? produto;

    protected override async Task OnInitializedAsync()
    {
        produto = await ProdutoService.GetProdutoByIdAsync(Id);
    }

    private void AdicionarAoCarrinho()
    {
        if (produto != null && produto.Stock > 0)
        {
            Carrinho.Adicionar(produto);
            Navigation.NavigateTo("/carrinho");
        }
    }

    private void Voltar()
    {
        Navigation.NavigateTo("/");
    }

    private string GetFullImageUrl(string imagePath)
    {
        if (string.IsNullOrEmpty(imagePath)) return "";
        var baseUrl = Http.BaseAddress?.ToString() ?? "";
        var urlFinal = $"{baseUrl.TrimEnd('/')}/{imagePath.TrimStart('/')}";
        return $"{urlFinal}?v={DateTime.Now.Ticks}";
    }
}