@page "/checkout"
@using MyMedia.Client.RCL.Models
@using MyMedia.Client.RCL.Services
@using Microsoft.AspNetCore.Components.Authorization 
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims

@inject CarrinhoService CarrinhoSvc
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider

<div class="container mt-4">
    <h2 class="mb-4">💳 Finalizar Encomenda</h2>

    <div class="row">
        @* --- LADO ESQUERDO: FORMULÁRIO --- *@
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Dados de Envio e Pagamento</h5>
                </div>
                <div class="card-body">
                    <EditForm Model="dadosPedido" OnValidSubmit="ConfirmarPagamento">
                        <DataAnnotationsValidator />

                        @* Morada *@
                        <div class="mb-3">
                            <label class="form-label">Morada Completa</label>
                            <InputText @bind-Value="dadosPedido.Morada" class="form-control" placeholder="Ex: Rua da Liberdade, nº 10" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Cidade</label>
                                <InputText @bind-Value="dadosPedido.Cidade" class="form-control" placeholder="Ex: Lisboa" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Código Postal</label>
                                <InputText @bind-Value="dadosPedido.CodigoPostal" class="form-control" placeholder="Ex: 1000-001" required />
                            </div>
                        </div>

                        @* Pagamento *@
                        <div class="mb-4">
                            <label class="form-label">Método de Pagamento</label>
                            <InputSelect @bind-Value="dadosPedido.MetodoPagamento" class="form-select">
                                <option value="MBWay">📱 MBWay</option>
                                <option value="Visa">💳 Cartão de Crédito</option>
                                <option value="Multibanco">🏧 Referência Multibanco</option>
                            </InputSelect>
                        </div>

                        @* Botão de Pagar *@
                        <button type="submit" class="btn btn-success w-100 btn-lg" disabled="@processando">
                            @if (processando)
                            {
                                <span><span class="spinner-border spinner-border-sm"></span> A processar...</span>
                            }
                            else
                            {
                                <span>Pagar @CarrinhoSvc.Total().ToString("C")</span>
                            }
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        @* --- LADO DIREITO: RESUMO --- *@
        <div class="col-md-5">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <h5 class="card-title mb-3">Resumo do Pedido</h5>
                    <ul class="list-group list-group-flush mb-3 rounded">
                        @foreach (var item in CarrinhoSvc.GetItems())
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-white">
                                <div>
                                    <small class="fw-bold">@item.Produto.Titulo</small>
                                    <div class="text-muted small">Qtd: @item.Quantidade</div>
                                </div>
                                <span>@((item.Produto.PrecoFinal * item.Quantidade).ToString("C"))</span>
                            </li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
                        <span>Total a Pagar:</span>
                        <span class="text-success">@CarrinhoSvc.Total().ToString("C")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Inicializamos o DTO
    private CheckoutDto dadosPedido = new CheckoutDto { MetodoPagamento = "MBWay" };
    private bool processando = false;

    protected override void OnInitialized()
    {
        // Se o carrinho estiver vazio, manda de volta para a loja
        if (CarrinhoSvc.ContarItens() == 0)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task ConfirmarPagamento()
    {
        processando = true;

        try
        {

            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            // Tenta buscar o ID (pode vir como 'sub' ou 'NameIdentifier')
            var userId = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value
                         ?? user.FindFirst("sub")?.Value;

            // 1. Simular tempo de espera (opcional, só para parecer real)
            await Task.Delay(1500);

            // 2. Preencher a lista de itens no DTO
            dadosPedido.UserId = userId;

            dadosPedido.Itens = CarrinhoSvc.GetItems().Select(i => new CarrinhoItemDto
            {
                ProdutoId = i.Produto.Id,
                Quantidade = i.Quantidade
            }).ToList();

            // 3. Enviar para a API
            var response = await Http.PostAsJsonAsync("api/encomendas", dadosPedido);

            if (response.IsSuccessStatusCode)
            {
                // 4. Limpar o carrinho e ir para a página de sucesso
                CarrinhoSvc.Limpar();
                Navigation.NavigateTo("/sucesso");
            }
            else
            {
                Console.WriteLine("Erro ao processar pagamento.");
                // Aqui podias mostrar uma mensagem de erro ao utilizador
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro: {ex.Message}");
        }
        finally
        {
            processando = false;
        }
    }
}