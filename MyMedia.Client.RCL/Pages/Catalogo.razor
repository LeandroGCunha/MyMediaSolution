@page "/catalogo"
@using MyMedia.Data.Entities
@using MyMedia.Client.RCL.Services
@inject ClientProdutoService ProdutoService
@inject HttpClient Http

<PageTitle>Catálogo - MyMedia</PageTitle>

<style>
    /* Cores Premium */
    .text-gold {
        color: #ffc107 !important;
    }

    .bg-gold {
        background-color: #ffc107 !important;
        color: #000;
    }

    .border-gold {
        border-color: #ffc107 !important;
    }

    /* Estilo dos Cartões de Produto */
    .product-card {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border: 1px solid rgba(0,0,0,0.05);
        background: white;
    }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
            border-color: #ffc107;
        }

            .product-card:hover .btn-view {
                background-color: #ffc107;
                color: black;
                border-color: #ffc107;
            }

    /* Botão Ver Detalhes */
    .btn-view {
        transition: 0.3s;
        border-radius: 50px;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
    }

    /* Arvore de Categorias */
    .tree-btn {
        transition: all 0.2s;
        border-radius: 4px;
        color: #495057;
    }

        .tree-btn:hover {
            background-color: #f8f9fa;
            color: #ffc107;
            padding-left: 20px !important;
        }

        .tree-btn.selected {
            background-color: #1a1a1a !important; /* Preto */
            color: #ffc107 !important; /* Amarelo */
            border-left: 3px solid #ffc107 !important;
            font-weight: bold;
        }

    /* Scrollbar personalizada para categorias */
    .category-scroll::-webkit-scrollbar {
        width: 5px;
    }

    .category-scroll::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .category-scroll::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 10px;
    }
</style>

@* --- Lógica da Árvore de Categorias (Mantive igual) --- *@
@{
    RenderFragment<Categoria> RenderCategoriaTree = null!;
    RenderCategoriaTree = (cat) =>
    @<text>
    @{
        bool isSelected = categoriasSelecionadas.Contains(cat.Id);
        var subcategorias = categoriasDisponiveis.Where(sub => sub.CategoriaPaiId == cat.Id).ToList();
    }
        <button class="btn btn-sm w-100 text-start d-flex justify-content-between align-items-center mb-1 tree-btn @(isSelected ? "selected" : "btn-light bg-transparent")"
                style="padding-left: @(cat.CategoriaPaiId == null ? "10px" : "15px");"
                @onclick="() => AlternarCategoria(cat.Id)">
            <span class="text-truncate">
                @if (cat.CategoriaPaiId != null)
                {
                    <i class="bi bi-arrow-return-right me-1 small opacity-50"></i>
                }
                @cat.Nome
            </span>
            @if (isSelected)
            {
                <i class="bi bi-check-circle-fill small text-gold"></i>
            }
        </button>
    @if (subcategorias.Any())
    {
            <div class="ms-3 border-start ps-1 mb-2">
                @foreach (var sub in subcategorias)
                {
                    @RenderCategoriaTree(sub)
                }
            </div>
    }
    </text>;
}

<div class="container mt-4 mb-5">
    <div class="row">

        @* --- COLUNA DA ESQUERDA (FILTROS) --- *@
        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm border-0 sticky-top rounded-4 overflow-hidden" style="top: 90px; z-index: 1;">

                @* Cabeçalho Preto e Amarelo *@
                <div class="card-header bg-dark text-white fw-bold d-flex align-items-center py-3">
                    <i class="bi bi-sliders me-2 text-gold"></i> Filtros
                </div>

                <div class="card-body bg-white">

                    @* Pesquisa *@
                    <div class="mb-4">
                        <label class="form-label small text-muted text-uppercase fw-bold">Pesquisar</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control bg-light border-start-0"
                                   placeholder="O que procura?"
                                   @bind="termoPesquisa"
                                   @bind:event="oninput"
                                   @onkeyup="FiltrarProdutos" />
                        </div>
                    </div>

                    @* Categorias *@
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label small text-muted text-uppercase fw-bold m-0">Categorias</label>
                            @if (categoriasSelecionadas.Count > 0)
                            {
                                <button class="btn btn-link btn-sm p-0 text-decoration-none text-danger fw-bold" style="font-size: 0.7rem;" @onclick="LimparCategorias">
                                    LIMPAR
                                </button>
                            }
                        </div>

                        <div class="category-scroll" style="max-height: 400px; overflow-y: auto;">
                            <button class="btn btn-sm w-100 text-start mb-1 tree-btn @(categoriasSelecionadas.Count == 0 ? "selected" : "btn-light bg-transparent")"
                                    @onclick="LimparCategorias">
                                <i class="bi bi-grid-fill me-2"></i> Todas
                            </button>

                            @if (categoriasDisponiveis.Any())
                            {
                                var raizes = categoriasDisponiveis.Where(c => c.CategoriaPaiId == null || !categoriasDisponiveis.Any(x => x.Id == c.CategoriaPaiId)).ToList();
                                @foreach (var cat in raizes)
                                {
                                    @RenderCategoriaTree(cat)
                                }
                            }
                        </div>
                    </div>

                    @* Ordenação *@
                    <div>
                        <label class="form-label small text-muted text-uppercase fw-bold">Ordenar por</label>
                        <select class="form-select form-select-sm bg-light border-0" @onchange="OrdenarProdutos">
                            <option value="padrao">✨ Recomendados</option>
                            <option value="menor_preco">📉 Preço: Baixo -> Alto</option>
                            <option value="maior_preco">📈 Preço: Alto -> Baixo</option>
                            <option value="az">🔤 Nome: A - Z</option>
                        </select>
                    </div>

                </div>
            </div>
        </div>

        @* --- COLUNA DA DIREITA (PRODUTOS) --- *@
        <div class="col-lg-9">

            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h3 class="fw-bold m-0 text-dark">Catálogo</h3>
                <span class="badge bg-gold text-dark border border-dark rounded-pill px-3 py-2 fw-bold">
                    @produtosFiltrados.Count produtos
                </span>
            </div>

            @if (carregando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-gold" role="status"></div>
                </div>
            }
            else if (!produtosFiltrados.Any())
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                    <div class="mb-3">
                        <i class="bi bi-emoji-frown fs-1 text-muted opacity-50"></i>
                    </div>
                    <h5 class="fw-bold">Ups! Nada encontrado.</h5>
                    <p class="text-muted">Tente mudar os filtros ou a pesquisa.</p>
                    <button class="btn btn-outline-dark mt-2 rounded-pill px-4" @onclick="LimparTudo">Limpar Tudo</button>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                    @foreach (var p in produtosFiltrados)
                    {
                        <div class="col">
                            <div class="card h-100 product-card rounded-4 overflow-hidden border-0">

                                @* Imagem *@
                                <div class="position-relative bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
                                    @if (!string.IsNullOrEmpty(p.ImagemUrl))
                                    {
                                        <img src="@GetFullImageUrl(p.ImagemUrl)" class="w-100 h-100" style="object-fit: cover; mix-blend-mode: multiply;">
                                    }
                                    else
                                    {
                                        <i class="bi bi-camera fs-1 text-muted opacity-25"></i>
                                    }

                                    @* Preço Flutuante *@
                                    <span class="position-absolute bottom-0 end-0 m-2 badge bg-dark text-gold px-3 py-2 rounded-3 shadow-sm" style="font-size: 0.9rem;">
                                        @p.PrecoFinal.ToString("C")
                                    </span>
                                </div>

                                <div class="card-body d-flex flex-column p-3">
                                    <div class="mb-auto">
                                        <small class="text-uppercase text-muted fw-bold" style="font-size: 0.65rem;">
                                            @p.Categoria?.Nome
                                        </small>
                                        <h6 class="card-title fw-bold mt-1 text-truncate text-dark">
                                            @p.Titulo
                                        </h6>
                                    </div>

                                    <div class="mt-3">
                                        <a href="/produto/@p.Id" class="btn btn-outline-dark w-100 btn-view btn-sm">
                                            Ver Detalhes
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Produto> todosProdutos = new();
    private List<Produto> produtosFiltrados = new();
    private List<Categoria> categoriasDisponiveis = new();
    private HashSet<int> categoriasSelecionadas = new();

    private bool carregando = true;
    private string termoPesquisa = "";
    private string ordemAtual = "padrao";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            carregando = true;
            var taskProdutos = ProdutoService.GetProdutosAsync();
            var taskCategorias = ProdutoService.GetCategoriasAsync();

            await Task.WhenAll(taskProdutos, taskCategorias);

            var resultadoProdutos = await taskProdutos;
            if (resultadoProdutos != null)
            {
                // 👇 AQUI ESTÁ A CORREÇÃO
                todosProdutos = resultadoProdutos
                                    .Where(p => p.Estado == EstadoProduto.Ativo)
                                    .ToList();

                produtosFiltrados = new List<Produto>(todosProdutos);
            }

            var resultadoCategorias = await taskCategorias;
            if (resultadoCategorias != null)
            {
                categoriasDisponiveis = resultadoCategorias.OrderBy(c => c.Nome).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erro: " + ex.Message);
        }
        finally
        {
            carregando = false;
        }
    }

    private void ObterIdsComDescendentes(int idCategoriaPai, HashSet<int> listaAcumulada)
    {
        listaAcumulada.Add(idCategoriaPai);
        var filhos = categoriasDisponiveis.Where(c => c.CategoriaPaiId == idCategoriaPai);
        foreach (var filho in filhos)
        {
            ObterIdsComDescendentes(filho.Id, listaAcumulada);
        }
    }

    private void FiltrarProdutos()
    {
        var query = todosProdutos.AsEnumerable();

        if (categoriasSelecionadas.Count > 0)
        {
            var idsExpandidos = new HashSet<int>();
            foreach (var idSelecionado in categoriasSelecionadas)
            {
                ObterIdsComDescendentes(idSelecionado, idsExpandidos);
            }
            query = query.Where(p => p.CategoriaId.HasValue && idsExpandidos.Contains(p.CategoriaId.Value));
        }

        if (!string.IsNullOrWhiteSpace(termoPesquisa))
        {
            query = query.Where(p => p.Titulo.Contains(termoPesquisa, StringComparison.OrdinalIgnoreCase));
        }

        query = ordemAtual switch
        {
            "menor_preco" => query.OrderBy(p => p.PrecoFinal),
            "maior_preco" => query.OrderByDescending(p => p.PrecoFinal),
            "az" => query.OrderBy(p => p.Titulo),
            _ => query.OrderByDescending(p => p.Id)
        };

        produtosFiltrados = query.ToList();
    }

    private void AlternarCategoria(int idCategoria)
    {
        if (categoriasSelecionadas.Contains(idCategoria))
            categoriasSelecionadas.Remove(idCategoria);
        else
            categoriasSelecionadas.Add(idCategoria);

        FiltrarProdutos();
    }

    private void LimparCategorias()
    {
        categoriasSelecionadas.Clear();
        FiltrarProdutos();
    }

    private void OrdenarProdutos(ChangeEventArgs e)
    {
        ordemAtual = e.Value?.ToString() ?? "padrao";
        FiltrarProdutos();
    }

    private void LimparTudo()
    {
        termoPesquisa = "";
        categoriasSelecionadas.Clear();
        ordemAtual = "padrao";
        FiltrarProdutos();
    }

    private string GetFullImageUrl(string imagePath)
    {
        if (string.IsNullOrEmpty(imagePath)) return "";
        var baseUrl = Http.BaseAddress?.ToString() ?? "";
        var urlFinal = $"{baseUrl.TrimEnd('/')}/{imagePath.TrimStart('/')}";
        return $"{urlFinal}?v={DateTime.Now.Ticks}";
    }
}