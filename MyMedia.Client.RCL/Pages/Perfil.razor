@page "/perfil"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<style>
    .text-gold {
        color: #ffc107 !important;
    }

    .bg-gold {
        background-color: #ffc107;
        color: #000;
    }

    /* Cartão de Perfil */
    .profile-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        border-top: 5px solid #ffc107;
    }

    /* Avatar */
    .avatar-circle {
        width: 100px;
        height: 100px;
        background-color: #1a1a1a;
        color: #ffc107;
        font-size: 2.5rem;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 4px solid white;
        box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        border-radius: 50%;
        margin-top: -50px; /* Sobe para ficar metade fora do header */
    }

    /* Cabeçalho do Cartão */
    .card-header-bg {
        background: linear-gradient(45deg, #1a1a1a, #333);
        height: 120px;
    }
</style>

<div class="container mt-4 mb-5">

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <h3 class="fw-bold mb-4 text-center">
                <i class="bi bi-person-circle text-gold me-2"></i> Minha Conta
            </h3>

            <div class="profile-card">
                @* 1. Fundo Decorativo *@
                <div class="card-header-bg"></div>

                <div class="text-center">
                    @* 2. Avatar (Iniciais) *@
                    <div class="d-flex justify-content-center">
                        <div class="avatar-circle">
                            @Iniciais
                        </div>
                    </div>

                    <div class="px-4 pb-4 mt-3">
                        @* 3. Nome e Role *@
                        <h4 class="fw-bold mb-1">@Nome</h4>

                        @if (IsFornecedor)
                        {
                            <span class="badge bg-gold mb-3">
                                <i class="bi bi-briefcase-fill me-1"></i> Fornecedor Parceiro
                            </span>
                        }
                        else if (IsAdmin)
                        {
                            <span class="badge bg-danger mb-3">
                                <i class="bi bi-shield-lock-fill me-1"></i> Administrador
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark border mb-3">
                                <i class="bi bi-emoji-smile me-1"></i> Cliente
                            </span>
                        }

                        <hr class="opacity-25 my-3">

                        @* 4. Detalhes (Lista) *@
                        <div class="text-start">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-light rounded-circle p-2 me-3 text-secondary">
                                    <i class="bi bi-envelope-fill fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">EMAIL</small>
                                    <span class="fw-bold text-dark">@Email</span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-light rounded-circle p-2 me-3 text-secondary">
                                    <i class="bi bi-calendar-check-fill fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">ESTADO DA CONTA</small>
                                    <span class="text-success fw-bold">Ativa e Verificada</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            @if (IsFornecedor)
                            {
                                <a href="painel-vendas" class="btn btn-outline-dark rounded-pill">
                                    <i class="bi bi-graph-up me-2"></i> Ver Minhas Vendas
                                </a>
                            }
                            else
                            {
                                <a href="minhas-encomendas" class="btn btn-outline-dark rounded-pill">
                                    <i class="bi bi-box-seam me-2"></i> Minhas Encomendas
                                </a>
                            }

                            <a href="/account/logout" class="btn btn-danger rounded-pill mt-2">
                                <i class="bi bi-box-arrow-right me-2"></i> Terminar Sessão
                            </a>
                        </div>

                    </div>
                </div>
            </div>

            <div class="text-center mt-3">
                <a href="/" class="text-muted text-decoration-none small">Voltar ao Início</a>
            </div>

        </div>
    </div>
</div>

@code {
    private string Nome = "Carregando...";
    private string Email = "";
    private string Iniciais = "U";

    private bool IsFornecedor = false;
    private bool IsAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            // Pega o nome
            Nome = user.Identity.Name ?? "Utilizador";

            // Pega o Email (dependendo de como o Identity guarda, pode ser ClaimTypes.Email ou "email")
            Email = user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("email")?.Value ?? "Sem Email";

            // Roles
            IsFornecedor = user.IsInRole("Fornecedor");
            IsAdmin = user.IsInRole("Administrador");

            // Calcula Iniciais
            if (!string.IsNullOrEmpty(Nome))
            {
                var partes = Nome.Split(' ');
                if (partes.Length >= 1)
                {
                    Iniciais = partes[0].Substring(0, 1).ToUpper();
                    if (partes.Length > 1)
                    {
                        Iniciais += partes[partes.Length - 1].Substring(0, 1).ToUpper();
                    }
                }
            }
        }
    }
}