@page "/meus-produtos"
@attribute [Authorize(Roles = "Fornecedor")]

@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using MyMedia.Client.RCL.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using MyMedia.Data.Entities
@using Microsoft.JSInterop

@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

@* --- ESTILOS PREMIUM --- *@
<style>
    .text-gold {
        color: #ffc107 !important;
    }

    .btn-gold {
        background-color: #ffc107;
        color: #000;
        font-weight: bold;
        border: none;
    }

        .btn-gold:hover {
            background-color: #e0a800;
        }

    @@media (max-width: 768px) {
        .desktop-table {
            display: none;
        }

        .mobile-cards {
            display: block;
        }
    }

    @@media (min-width: 769px) {
        .desktop-table {
            display: table;
        }

        .mobile-cards {
            display: none;
        }
    }

    .product-card-mobile {
        border-left: 5px solid #ffc107;
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        margin-bottom: 1rem;
        overflow: hidden;
    }
</style>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold m-0"><i class="bi bi-box-seam me-2 text-gold"></i> Meu Catálogo</h3>
        <button class="btn btn-gold rounded-pill px-4 shadow-sm" @onclick="IrParaCriar">
            <i class="bi bi-plus-lg me-1"></i> Novo
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="alert alert-danger shadow-sm"><i class="bi bi-exclamation-triangle-fill me-2"></i> @mensagemErro</div>
    }
    else if (meusProdutos == null)
    {
        <div class="text-center py-5"><div class="spinner-border text-gold" role="status"></div><p class="mt-2 text-muted">A carregar...</p></div>
    }
    else if (!meusProdutos.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <h4>Ainda não tem produtos!</h4>
            <button class="btn btn-outline-dark mt-2" @onclick="IrParaCriar">Criar Primeiro Produto</button>
        </div>
    }
    else
    {
        @* --- VERSÃO PC --- *@
        <div class="table-responsive desktop-table rounded-3 shadow-sm">
            <table class="table table-hover bg-white mb-0 align-middle">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="py-3 ps-3">Produto</th>
                        <th>Categoria</th>
                        <th>Preço</th>
                        <th>Stock</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end pe-3">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in meusProdutos)
                    {
                        <tr>
                            <td class="ps-3">
                                <div class="d-flex align-items-center">
                                    <img src="@GetFullImageUrl(p.ImagemUrl)" class="rounded-3 border me-3" style="width: 48px; height: 48px; object-fit: cover;">
                                    <span class="fw-bold text-dark">@p.Titulo</span>
                                </div>
                            </td>
                            <td>@(p.Categoria?.Nome ?? "-")</td>
                            <td class="fw-bold text-success">@p.PrecoFinal.ToString("C")</td>
                            <td>
                                @if (p.Stock <= 0)
                                {
                                    <span class="badge bg-danger">Esgotado</span>
                                }
                                else
                                {

                                    <span>@p.Stock un.</span>
                                }
                            </td>

                            @* CORREÇÃO: Usar Enum Estado *@
                            <td class="text-center">
                                @switch (p.Estado)
                                {
                                    case EstadoProduto.Ativo:
                                        <span class="badge bg-success rounded-pill px-3">Ativo</span>
                                        break;
                                    case EstadoProduto.Pausado:
                                        <span class="badge bg-secondary rounded-pill px-3">Pausado</span>
                                        break;
                                    case EstadoProduto.Pendente:
                                        <span class="badge bg-warning text-dark rounded-pill px-3">Pendente</span>
                                        break;
                                    case EstadoProduto.Rejeitado:
                                        <span class="badge bg-danger rounded-pill px-3">Rejeitado</span>
                                        break;
                                }
                            </td>

                            <td class="text-end pe-3">
                                <div class="btn-group">
                                    <a href="/produto/editar/@p.Id" class="btn btn-sm btn-outline-dark" title="Editar"><i class="bi bi-pencil"></i></a>

                                    @* CORREÇÃO: Botão Toggle com Enum *@
                                    @if (p.Estado == EstadoProduto.Ativo || p.Estado == EstadoProduto.Pausado)
                                    {
                                        <button class="btn btn-sm @(p.Estado == EstadoProduto.Ativo ? "btn-outline-warning text-dark" : "btn-outline-success")"
                                                title="@(p.Estado == EstadoProduto.Ativo ? "Pausar" : "Ativar")"
                                                @onclick="() => AlternarEstado(p)">
                                            <i class="bi @(p.Estado == EstadoProduto.Ativo ? "bi-pause-fill" : "bi-play-fill")"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-light disabled"><i class="bi bi-clock"></i></button>
                                    }

                                    <button class="btn btn-sm btn-outline-danger" title="Apagar" @onclick="() => ApagarProduto(p)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* --- VERSÃO MOBILE --- *@
        <div class="mobile-cards">
            @foreach (var p in meusProdutos)
            {
                <div class="product-card-mobile p-3">
                    <div class="d-flex gap-3">
                        <div style="width: 80px; height: 80px; flex-shrink: 0;">
                            <img src="@GetFullImageUrl(p.ImagemUrl)" class="w-100 h-100 rounded bg-light border" style="object-fit: cover;">
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h6 class="fw-bold mb-0 text-truncate" style="max-width: 150px;">@p.Titulo</h6>

                                @if (p.Estado == EstadoProduto.Ativo)
                                {
                                    <span class="badge bg-success">Ativo</span>
                                }
                                else if (p.Estado == EstadoProduto.Pausado)
                                {

                                    <span class="badge bg-secondary">Pausado</span>
                                }
                                else
                                {

                                    <span class="badge bg-warning text-dark">Pendente</span>
                                }
                            </div>
                            <small class="text-muted d-block mb-2">@(p.Categoria?.Nome ?? "Sem Categoria")</small>
                            <span class="text-dark fw-bold fs-5">@p.PrecoFinal.ToString("C")</span>
                        </div>
                    </div>
                    <div class="mt-3 pt-3 border-top d-flex gap-2">
                        <a href="/produto/editar/@p.Id" class="btn btn-outline-dark btn-sm flex-grow-1"><i class="bi bi-pencil me-1"></i> Editar</a>

                        @if (p.Estado == EstadoProduto.Ativo || p.Estado == EstadoProduto.Pausado)
                        {
                            <button class="btn btn-sm flex-grow-1 @(p.Estado == EstadoProduto.Ativo ? "btn-outline-warning text-dark" : "btn-outline-success")"
                                    @onclick="() => AlternarEstado(p)">
                                @if (p.Estado == EstadoProduto.Ativo)
                                {
                                    <span><i class="bi bi-pause-fill me-1"></i> Pausar</span>
                                }
                                else
                                {

                                    <span><i class="bi bi-play-fill me-1"></i> Ativar</span>
                                }
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm flex-grow-1 btn-light disabled"> Aguarde... </button>
                        }

                        <button class="btn btn-outline-danger btn-sm" @onclick="() => ApagarProduto(p)"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Produto>? meusProdutos;
    private string userId = "";
    private string mensagemErro = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var claimId = user.FindFirst(ClaimTypes.NameIdentifier) ?? user.FindFirst("sub") ?? user.FindFirst("id");
                if (claimId != null)
                {
                    userId = claimId.Value;
                    meusProdutos = await Http.GetFromJsonAsync<List<Produto>>($"api/produtos/por-fornecedor/{userId}");
                }
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro: {ex.Message}";
            meusProdutos = new List<Produto>();
        }
    }

    private void IrParaCriar() => Nav.NavigateTo("/criar-produto");

    private string GetFullImageUrl(string imagePath)
    {
        if (string.IsNullOrEmpty(imagePath)) return "";
        var baseUrl = Http.BaseAddress?.ToString() ?? "";
        var urlFinal = $"{baseUrl.TrimEnd('/')}/{imagePath.TrimStart('/')}";
        return $"{urlFinal}?v={DateTime.Now.Ticks}";
    }

    // 👇 CORREÇÃO: AlternarEstado usando Enum
    private async Task AlternarEstado(Produto produto)
    {
        var estadoOriginal = produto.Estado;

        // Lógica de Toggle: Se Ativo -> Pausado. Se Pausado -> Ativo.
        if (produto.Estado == EstadoProduto.Ativo)
            produto.Estado = EstadoProduto.Pausado;
        else if (produto.Estado == EstadoProduto.Pausado)
            produto.Estado = EstadoProduto.Ativo;

        try
        {
            var resposta = await Http.PutAsJsonAsync($"api/produtos/{produto.Id}", produto);

            if (!resposta.IsSuccessStatusCode)
            {
                produto.Estado = estadoOriginal; // Reverte
                await JSRuntime.InvokeVoidAsync("alert", "Não permitido: O Admin ainda não aprovou.");
            }
        }
        catch (Exception)
        {
            produto.Estado = estadoOriginal;
            await JSRuntime.InvokeVoidAsync("alert", "Erro de ligação.");
        }
    }

    private async Task ApagarProduto(Produto produtoParaApagar)
    {
        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", $"Tem a certeza que deseja apagar '{produtoParaApagar.Titulo}'?");
        if (confirmado)
        {
            try
            {
                var resposta = await Http.DeleteAsync($"api/produtos/{produtoParaApagar.Id}");
                if (resposta.IsSuccessStatusCode) meusProdutos?.Remove(produtoParaApagar);
                else await JSRuntime.InvokeVoidAsync("alert", "Erro ao apagar. Pode ter vendas associadas.");
            }
            catch (Exception ex) { Console.WriteLine($"Erro: {ex.Message}"); }
        }
    }
}