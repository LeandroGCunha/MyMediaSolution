@page "/criar-produto"
@attribute [Authorize(Roles = "Fornecedor")]

@using System.Security.Claims
@using System.IO
@using MyMedia.Data.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

@* --- ESTILOS PREMIUM (Igual ao Editar) --- *@
<style>
    .text-gold {
        color: #ffc107 !important;
    }

    /* Botão Principal Dourado */
    .btn-gold {
        background-color: #ffc107;
        color: #000;
        font-weight: bold;
        border: none;
        transition: 0.2s;
    }

        .btn-gold:hover {
            background-color: #e0a800;
            transform: scale(1.02);
        }

    /* Inputs Modernos */
    .form-control:focus, .form-select:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
    }

    /* Área de Upload */
    .upload-area {
        border: 2px dashed #ccc;
        border-radius: 10px;
        background-color: #f8f9fa;
        transition: 0.3s;
    }

        .upload-area:hover {
            border-color: #ffc107;
            background-color: #fffbf0;
        }
</style>

<div class="container mt-4 mb-5">

    <div class="d-flex align-items-center mb-4">
        <a href="/meus-produtos" class="btn btn-outline-dark rounded-circle me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h3 class="fw-bold m-0">Novo Produto</h3>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            @* Aviso Inicial *@
            <div class="alert alert-info border-info d-flex align-items-center rounded-3 shadow-sm mb-4">
                <i class="bi bi-info-circle-fill fs-4 me-3"></i>
                <div>
                    <strong>Nota:</strong> O teu produto ficará
                    <span class="badge bg-warning text-dark">Pendente</span> até ser aprovado por um administrador.
                </div>
            </div>

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-dark text-white py-3">
                    <i class="bi bi-plus-circle text-gold me-2"></i> Dados do Novo Produto
                </div>

                <div class="card-body p-4">
                    <EditForm Model="produto" OnValidSubmit="GuardarProduto">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        @* 1. ÁREA DE IMAGEM *@
                        <div class="mb-4 text-center">
                            <label class="form-label fw-bold d-block text-start">Imagem do Produto</label>

                            <div class="upload-area p-3">
                                @if (!string.IsNullOrEmpty(imagemPreview))
                                {
                                    <div class="mb-3 position-relative d-inline-block">
                                        <img src="@imagemPreview" class="img-fluid rounded shadow-sm border"
                                             style="max-height: 200px; object-fit: contain;" />
                                    </div>
                                }
                                else
                                {
                                    <div class="py-4 text-muted">
                                        <i class="bi bi-camera fs-1 opacity-25"></i>
                                        <p class="small">Nenhuma imagem selecionada</p>
                                    </div>
                                }

                                <div class="mt-2">
                                    <label class="btn btn-outline-dark btn-sm">
                                        <i class="bi bi-upload me-2"></i> Carregar Foto
                                        <InputFile OnChange="CarregarImagemPreview" class="d-none" accept="image/*" />
                                    </label>
                                    <div class="form-text small mt-1">Formatos: JPG, PNG (Max: 5MB)</div>
                                </div>
                            </div>
                        </div>

                        @* 2. CAMPOS DE TEXTO *@
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-bold">Título</label>
                                <InputText class="form-control" @bind-Value="produto.Titulo" placeholder="Ex: iPhone 15 Pro..." />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Descrição Detalhada</label>
                                <InputTextArea class="form-control" @bind-Value="produto.Descricao" rows="4" placeholder="Detalhes, especificações..." />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Categoria</label>
                                <InputSelect TValue="int?" class="form-select" @bind-Value="produto.CategoriaId">
                                    <option value="">-- Selecione --</option>
                                    @foreach (var cat in listaCategorias)
                                    {
                                        <option value="@cat.Id">@cat.Nome</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold">Preço (€)</label>
                                <InputNumber TValue="decimal" class="form-control" @bind-Value="produto.PrecoBase" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold">Stock</label>
                                <InputNumber TValue="int" class="form-control" @bind-Value="produto.Stock" />
                            </div>
                        </div>

                        @* 3. BOTÕES *@
                        <div class="d-grid gap-2 mt-5">
                            <button type="submit" class="btn btn-gold py-3 rounded-pill shadow-sm" disabled="@estaAEnviar">
                                @if (estaAEnviar)
                                {
                                    <span><span class="spinner-border spinner-border-sm me-2"></span> A Enviar...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-send-check me-2"></i> SUBMETER PARA APROVAÇÃO</span>
                                }
                            </button>
                            <a href="/meus-produtos" class="btn btn-link text-muted text-decoration-none">
                                Cancelar
                            </a>
                        </div>

                        @if (!string.IsNullOrEmpty(mensagemErro))
                        {
                            <div class="alert alert-danger mt-3 mb-0 rounded-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensagemErro
                            </div>
                        }

                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Produto produto = new Produto();
    private List<Categoria> listaCategorias = new();
    private string? imagemPreview;
    private bool estaAEnviar = false;
    private string mensagemErro = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            listaCategorias = await Http.GetFromJsonAsync<List<Categoria>>("api/produtos/categorias") ?? new List<Categoria>();
        }
        catch
        {
            mensagemErro = "Não foi possível carregar as categorias.";
        }
    }

    private async Task CarregarImagemPreview(InputFileChangeEventArgs e)
    {
        var file = e.File;
        long maxFileSize = 1024 * 1024 * 10; // 10MB limite
        var format = "image/png";

        try
        {
            var resizedImage = await file.RequestImageFileAsync(format, 500, 500);
            using var stream = resizedImage.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            imagemPreview = $"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}";
            produto.ImagemUrl = imagemPreview;
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro na imagem: {ex.Message}";
        }
    }

    private async Task GuardarProduto()
    {
        estaAEnviar = true;
        mensagemErro = "";

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value
                      ?? user.FindFirst("sub")?.Value;

            if (userId == null)
            {
                mensagemErro = "Erro: Sessão inválida. Faz login novamente.";
                estaAEnviar = false;
                return;
            }

            // Configuração Inicial do Produto
            produto.FornecedorId = userId;
            produto.Id = 0;
            produto.Estado = EstadoProduto.Pendente; // Força pendente
            produto.MargemLucro = 0;
            produto.PrecoFinal = produto.PrecoBase;

            var response = await Http.PostAsJsonAsync("api/produtos", produto);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/meus-produtos");
            }
            else
            {
                var erroDetalhes = await response.Content.ReadAsStringAsync();
                mensagemErro = $"Erro ao criar produto. A API rejeitou o pedido.";
                Console.WriteLine($"[API ERRO]: {erroDetalhes}");
            }
        }
        catch (Exception ex)
        {
            mensagemErro = "Erro de ligação: " + ex.Message;
        }
        finally
        {
            estaAEnviar = false;
        }
    }
}