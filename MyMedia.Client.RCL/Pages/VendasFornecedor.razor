@page "/painel-vendas"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using MyMedia.Data.Entities
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Roles = "Fornecedor")]

@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<style>
    /* Estilos Premium */
    .text-gold {
        color: #ffc107 !important;
    }

    .bg-gold {
        background-color: #ffc107 !important;
        color: #000;
    }

    .dashboard-card {
        border: none;
        border-radius: 12px;
        background: white;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        transition: transform 0.2s;
    }

        .dashboard-card:hover {
            transform: translateY(-3px);
        }

    /* Mobile Cards */
    .mobile-sale-card {
        background: white;
        border-radius: 10px;
        border-left: 5px solid #ffc107;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        margin-bottom: 15px;
        padding: 15px;
    }


    @@media (max-width: 768px) {
        .desktop-view

    {
        display: none !important;
    }

    .mobile-view {
        display: block !important;
    }

    }

    @@media (min-width: 769px) {
        .desktop-view {
            display: block !important;
        }

        .mobile-view {
            display: none !important;
        }
    }
</style>

<div class="container mt-4 mb-5">

    @* --- CABEÇALHO --- *@
    <div class="row align-items-center mb-4 g-3">
        <div class="col-md-8">
            <h3 class="fw-bold mb-1"><i class="bi bi-graph-up-arrow text-gold me-2"></i>Painel de Vendas</h3>
            <p class="text-muted mb-0">Acompanha as tuas encomendas e ganhos em tempo real.</p>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card p-3 d-flex align-items-center justify-content-between bg-dark text-white">
                <div>
                    <small class="text-white-50 text-uppercase fw-bold" style="font-size: 0.75rem;">Lucro Confirmado</small>
                    <h2 class="m-0 fw-bold text-gold">@TotalGanho.ToString("C")</h2>
                </div>
                <div class="rounded-circle bg-white d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-wallet2 text-dark fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    @* --- ESTADOS DE CARREGAMENTO --- *@
    @if (!string.IsNullOrEmpty(mensagemErro))
    {
        <div class="alert alert-danger shadow-sm border-0 rounded-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @mensagemErro
        </div>
    }
    else if (minhasVendas == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-gold" role="status"></div>
            <p class="mt-3 text-muted fw-bold">A carregar os teus dados...</p>
        </div>
    }
    else if (!minhasVendas.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm">
            <div class="mb-3"><i class="bi bi-shop display-1 text-muted opacity-25"></i></div>
            <h4>Ainda não tens vendas! 😢</h4>
            <p class="text-muted">Assim que os clientes comprarem os teus produtos, eles aparecerão aqui.</p>
        </div>
    }
    else
    {
        @* --- VERSÃO DESKTOP --- *@
        <div class="desktop-view table-responsive rounded-3 shadow-sm bg-white">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary small text-uppercase">
                    <tr>
                        <th class="py-3 ps-4">Data / ID</th>
                        <th>Cliente</th>
                        <th>Os Teus Produtos</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end pe-4">O Teu Lucro</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var venda in minhasVendas)
                    {
                        var meusItens = ObterMeusItens(venda);
                        var meuTotal = CalcularTotalVenda(meusItens);

                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@venda.Data.ToShortDateString()</div>
                                <span class="badge bg-light text-secondary border mt-1">#@venda.Id</span>
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@(venda.ApplicationUser?.NomeCompleto ?? "Cliente")</span>
                            </td>
                            <td>
                                <ul class="list-unstyled mb-0 small text-muted">
                                    @foreach (var item in meusItens)
                                    {
                                        <li class="mb-1">
                                            <span class="fw-bold text-dark">@item.Quantidade x</span> @item.Produto?.Titulo
                                        </li>
                                    }
                                </ul>
                            </td>
                            <td class="text-center">@RenderBadgeEstado(venda.Estado)</td>
                            <td class="text-end pe-4">
                                <span class="fs-6 fw-bold text-success">@meuTotal.ToString("C")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* --- VERSÃO MOBILE --- *@
        <div class="mobile-view">
            @foreach (var venda in minhasVendas)
            {
                var meusItens = ObterMeusItens(venda);
                var meuTotal = CalcularTotalVenda(meusItens);

                <div class="mobile-sale-card">
                    <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-2">
                        <div>
                            <span class="badge bg-dark">#@venda.Id</span>
                            <span class="ms-2 text-muted small">@venda.Data.ToShortDateString()</span>
                        </div>
                        <div>@RenderBadgeEstado(venda.Estado)</div>
                    </div>

                    <div class="mb-2 d-flex align-items-center">
                        <i class="bi bi-person-circle text-muted me-2"></i>
                        <span class="fw-bold text-dark">@(venda.ApplicationUser?.NomeCompleto ?? "Cliente")</span>
                    </div>

                    <div class="bg-light p-2 rounded mb-3">
                        <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Itens vendidos:</small>
                        <ul class="list-unstyled mb-0 mt-1 small">
                            @foreach (var item in meusItens)
                            {
                                <li class="d-flex justify-content-between">
                                    <span>@item.Produto?.Titulo</span>
                                    <span class="fw-bold">x @item.Quantidade</span>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Lucro desta venda:</span>
                        <span class="fs-5 fw-bold text-success">@meuTotal.ToString("C")</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Encomenda>? minhasVendas;
    private string currentUserId = "";
    private string mensagemErro = "";
    private decimal TotalGanho = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var claimId = user.FindFirst(ClaimTypes.NameIdentifier) ?? user.FindFirst("sub") ?? user.FindFirst("id");

                if (claimId != null)
                {
                    currentUserId = claimId.Value;
                    minhasVendas = await Http.GetFromJsonAsync<List<Encomenda>>($"api/encomendas/fornecedor/{currentUserId}");
                    CalcularTotalGeral();
                }
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro: {ex.Message}";
            minhasVendas = new List<Encomenda>();
        }
    }

    // 👇 Mudei 'DetalheEncomenda' para 'ItemEncomenda' (Verifica se é este o nome na tua Entidade)
    private List<ItemEncomenda> ObterMeusItens(Encomenda venda)
    {
        // Filtra para mostrar apenas os produtos que pertencem a este fornecedor
        return venda.Itens.Where(i => i.Produto?.FornecedorId == currentUserId).ToList();
    }

    private decimal CalcularTotalVenda(List<ItemEncomenda> itens)
    {
        return itens.Sum(i => i.PrecoUnitario * i.Quantidade);
    }

    private void CalcularTotalGeral()
    {
        if (minhasVendas == null) return;
        TotalGanho = 0;

        foreach (var venda in minhasVendas)
        {
            if (venda.Estado == "Enviada" || venda.Estado == "Paga" || venda.Estado == "Em Processamento")
            {
                var itens = ObterMeusItens(venda);
                TotalGanho += CalcularTotalVenda(itens);
            }
        }
    }

    private RenderFragment RenderBadgeEstado(string estado) => builder =>
    {
        string classe = estado switch
        {
            "Enviada" => "bg-success",
            "Cancelada" => "bg-danger",
            "Paga" => "bg-info text-dark",
            _ => "bg-warning text-dark"
        };

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {classe} rounded-pill px-3");
        builder.AddContent(2, estado);
        builder.CloseElement();
    };
}