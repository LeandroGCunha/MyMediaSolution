@page "/sucesso"

<div class="container mt-5 text-center">
    <div class="card shadow-sm p-5 border-0" style="max-width: 600px; margin: 0 auto;">

        <div class="mb-4 text-success">
            <i class="bi bi-check-circle-fill" style="font-size: 5rem;"></i>
        </div>

        <h2 class="fw-bold mb-3">Encomenda Confirmada!</h2>

        <p class="text-muted fs-5">
            Obrigado pela tua compra. <br>
            Recebemos o teu pedido e vamos processá-lo em breve.
        </p>

        <div class="mt-4">
            <a href="/" class="btn btn-primary btn-lg">
                <i class="bi bi-arrow-left"></i> Voltar à Loja
            </a>
            <a href="/encomendas" class="btn btn-outline-secondary btn-lg ms-2">
                Ver Histórico
            </a>
        </div>
    </div>
</div>