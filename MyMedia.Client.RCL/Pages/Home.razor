@page "/"
@using MyMedia.Data.Entities
@using MyMedia.Client.RCL.Services
@inject HttpClient Http
@inject ClientProdutoService ProdutoService

<PageTitle>Catálogo MyMedia</PageTitle>

<style>
    /* --- ESTILO DO SLIDER HORIZONTAL (TIPO NETFLIX) --- */
    .slider-container {
        overflow-x: auto; /* Permite rolar para o lado */
        white-space: nowrap; /* Impede que os produtos caiam para a linha de baixo */
        padding-bottom: 20px; /* Espaço para a barra de scroll */
        scroll-behavior: smooth; /* Animação suave */
        /* Esconder a barra de scroll feia (Opcional) */
        scrollbar-width: thin;
        scrollbar-color: #0d6efd #f1f1f1;
    }

    /* Cada cartão dentro do slider */
    .slider-item {
        display: inline-block; /* Fica um ao lado do outro */
        width: 280px; /* Largura fixa para caberem +/- 4 no ecrã */
        margin-right: 20px; /* Espaço entre eles */
        vertical-align: top; /* Alinha pelo topo */
        white-space: normal; /* Permite que o texto dentro do cartão quebre linha */
    }

        /* Efeito ao passar o rato */
        .slider-item:hover {
            transform: scale(1.02);
            transition: 0.3s;
        }
</style>

@if (produtos == null)
{
    <div class="container mt-5 text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">A carregar a loja...</p>
    </div>
}
else
{
    @* --- SLIDER DE DESTAQUES --- *@
    <div class="container-fluid mt-4 mb-5">
        <h3 class="mb-3 ps-3 border-start border-4 border-primary">🔥 Destaques da Semana</h3>

        <div class="slider-container px-3">
            @foreach (var p in produtosDestaque)
            {
                <div class="slider-item">
                    <div class="card h-100 shadow-sm border-0">
                        <div style="height: 180px; overflow: hidden;" class="bg-light d-flex align-items-center justify-content-center position-relative">
                            @if (!string.IsNullOrEmpty(p.ImagemUrl))
                            {
                                @* 👇 AQUI: Usamos a função para gerar o link completo *@
                                <img src="@GetFullImageUrl(p.ImagemUrl)" class="card-img-top h-100 w-100" style="object-fit: cover;">
                            }
                            else
                            {
                                <i class="bi bi-camera text-muted fs-1"></i>
                            }
                            <span class="position-absolute bottom-0 end-0 bg-dark text-white px-2 py-1 m-2 rounded fw-bold small">
                                @p.PrecoFinal.ToString("C")
                            </span>
                        </div>

                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold text-truncate" title="@p.Titulo">@p.Titulo</h6>
                            <small class="text-muted d-block mb-2">@p.Categoria?.Nome</small>
                            <a href="/produto/@p.Id" class="btn btn-outline-primary btn-sm w-100 stretched-link">Ver</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @* --- LISTA DE TODOS OS PRODUTOS --- *@
    <div class="container mb-5">
        <h3 class="mb-4 border-bottom pb-2">Todos os Produtos</h3>

        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var p in produtos)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div style="height: 200px; overflow: hidden;" class="bg-light d-flex align-items-center justify-content-center">
                            @if (!string.IsNullOrEmpty(p.ImagemUrl))
                            {
                                @* 👇 AQUI: Usamos a função também *@
                                <img src="@GetFullImageUrl(p.ImagemUrl)" class="card-img-top h-100 w-100" style="object-fit: cover;">
                            }
                            else
                            {
                                <i class="bi bi-disc text-muted fs-1"></i>
                            }
                        </div>

                        <div class="card-body">
                            <h6 class="card-title text-truncate">@p.Titulo</h6>
                            <p class="card-text text-success fw-bold">@p.PrecoFinal.ToString("C")</p>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <a href="/produto/@p.Id" class="btn btn-primary w-100">Detalhes</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<Produto>? produtos;
    private List<Produto> produtosDestaque = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 1. Carregamos TODOS os produtos da API para uma variável temporária
            var todosOsProdutos = await ProdutoService.GetProdutosAsync();

            if (todosOsProdutos != null)
            {
                // 2. FILTRAGEM CRUCIAL:
                // Só passam para a variável global 'produtos' aqueles que estiverem ATIVOS.
                // Assim, o resto da página nunca vê produtos inativos.
                produtos = todosOsProdutos
                            .Where(p => p.IsAtivo == true)
                            .ToList();

                // 3. Criamos o destaque a partir da lista já filtrada
                produtosDestaque = produtos
                    .OrderBy(p => Guid.NewGuid()) // Aleatório
                    .Take(5)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    // 👇 A FUNÇÃO QUE RESOLVE O PROBLEMA DAS IMAGENS
    // Junta o endereço da API (Tunnel ou Localhost) ao caminho da imagem
    private string GetFullImageUrl(string imagePath)
    {
        if (string.IsNullOrEmpty(imagePath)) return "";

        // Pega no endereço base configurado no Program.cs / MauiProgram.cs
        var baseUrl = Http.BaseAddress?.ToString() ?? "";

        // Remove barras duplicadas para ficar um link limpo
        var urlFinal = $"{baseUrl.TrimEnd('/')}/{imagePath.TrimStart('/')}";

        // Adiciona o timestamp para evitar cache velha
        return $"{urlFinal}?v={DateTime.Now.Ticks}";
    }
}