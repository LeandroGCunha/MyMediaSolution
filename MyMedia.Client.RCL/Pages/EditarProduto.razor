@page "/produto/editar/{Id:int}"
@attribute [Authorize(Roles = "Fornecedor")]

@using System.Security.Claims
@using System.IO
@using MyMedia.Data.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation

<h3>✏️ Editar Produto</h3>

@if (produto == null)
{
    <p>A carregar dados...</p>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <strong>Atenção:</strong> Ao guardar qualquer alteração, o produto voltará ao estado
                <strong>Pendente</strong> e terá de ser aprovado novamente pelo Administrador.
            </div>

            <EditForm Model="produto" OnValidSubmit="AtualizarProduto">
                <DataAnnotationsValidator />
                <ValidationSummary />

                @* 1. TÍTULO *@
                <div class="mb-3">
                    <label>Título:</label>
                    <InputText class="form-control" @bind-Value="produto.Titulo" />
                </div>

                @* 2. DESCRIÇÃO *@
                <div class="mb-3">
                    <label>Descrição:</label>
                    <InputTextArea class="form-control" @bind-Value="produto.Descricao" rows="4" />
                </div>

                @* 3. IMAGEM *@
                <div class="mb-3 border p-3 rounded bg-light">
                    <label class="fw-bold">Imagem Atual:</label>
                    @if (!string.IsNullOrEmpty(imagemPreview))
                    {
                        <div class="mb-2">
                            @* Mostra a imagem nova ou a antiga *@
                            <img src="@imagemPreview" width="150" class="img-thumbnail" />
                        </div>
                    }

                    <label class="form-label mt-2">Alterar Imagem (Opcional):</label>
                    <InputFile OnChange="CarregarNovaImagem" class="form-control" accept=".jpg,.jpeg,.png" />
                </div>

                @* 4. CATEGORIA *@
                <div class="mb-3">
                    <label>Categoria:</label>
                    <InputSelect TValue="int?" class="form-select" @bind-Value="produto.CategoriaId">
                        <option value="">-- Selecione --</option>
                        @foreach (var cat in listaCategorias)
                        {
                            <option value="@cat.Id">@cat.Nome</option>
                        }
                    </InputSelect>
                </div>

                @* 5. PREÇO E STOCK *@
                <div class="row bg-light p-3 border rounded mb-3">
                    <div class="col-md-6 mb-3">
                        <label>Preço Base (€):</label>
                        <InputNumber TValue="decimal" class="form-control" @bind-Value="produto.PrecoBase" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label>Stock:</label>
                        <InputNumber TValue="int" class="form-control" @bind-Value="produto.Stock" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">💾 Guardar Alterações</button>
                <a href="/meus-produtos" class="btn btn-secondary ms-2">Cancelar</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; } // Recebe o ID da URL

    private Produto? produto; // Começa a null enquanto carrega
    private List<Categoria> listaCategorias = new();
    private string? imagemPreview;

    protected override async Task OnInitializedAsync()
    {
        // 1. Carregar Categorias
        listaCategorias = await Http.GetFromJsonAsync<List<Categoria>>("api/produtos/categorias") ?? new();

        // 2. Carregar o Produto que queremos editar
        try
        {
            produto = await Http.GetFromJsonAsync<Produto>($"api/produtos/{Id}");

            // Configurar a preview da imagem atual (se existir)
            if (produto != null && !string.IsNullOrEmpty(produto.ImagemUrl))
            {
                // Se for um caminho relativo, adiciona o endereço da API para veres a foto
                imagemPreview = produto.ImagemUrl.StartsWith("http")
                    ? produto.ImagemUrl
                    : $"{Http.BaseAddress}api/{produto.ImagemUrl}".Replace("api/imagens", "imagens");
                // Nota: O truque do replace é só para garantir que o link fica certo dependendo da tua configuração
            }
        }
        catch
        {
            Navigation.NavigateTo("/meus-produtos"); // Se der erro, volta para a lista
        }
    }

    private async Task CarregarNovaImagem(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var format = "image/png";
        var resized = await file.RequestImageFileAsync(format, 400, 400);

        using var stream = resized.OpenReadStream(1024 * 1024 * 5);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        // Atualiza a preview e o objeto produto com a nova Base64
        var base64 = Convert.ToBase64String(ms.ToArray());
        imagemPreview = $"data:{format};base64,{base64}";
        produto.ImagemUrl = imagemPreview;
    }

    private async Task AtualizarProduto()
    {
        if (produto == null) return;

        // O fornecedor NÃO pode definir IsAtivo a true.
        // A API vai forçar 'false' de qualquer forma, mas podemos pôr aqui também.
        produto.IsAtivo = false;

        // Enviar pedido PUT (Atualizar)
        var response = await Http.PutAsJsonAsync($"api/produtos/{Id}", produto);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/meus-produtos");
        }
        else
        {
            // Opcional: Tratar erro
        }
    }
}