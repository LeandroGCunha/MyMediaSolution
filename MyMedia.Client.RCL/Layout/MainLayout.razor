@inherits LayoutComponentBase
@using MyMedia.Client.RCL.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject CarrinhoService CarrinhoSvc
@inject NavigationManager Nav
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

@namespace MyMedia.Client.RCL.Layout

<div class="page d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-uppercase d-flex align-items-center gap-2" href="/">
                <i class="bi bi-play-circle-fill text-warning"></i> MyMedia
            </a>

            @* 1. BOTÃO HAMBÚRGUER (Agora chama a função C#) *@
            <button class="navbar-toggler" type="button" @onclick="ToggleNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            @* 2. ÁREA QUE ABRE E FECHA (A classe CSS muda dinamicamente) *@
            <div class="@NavMenuCssClass" id="navbarStore">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        @* Adicionei @onclick="CollapseNavbar" para o menu fechar quando clicas no link *@
                        <a class="nav-link" href="/" @onclick="CollapseNavbar">Início</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/catalogo" @onclick="CollapseNavbar">Catálogo</a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">

                    <li class="nav-item me-3">
                        <a class="btn btn-outline-warning btn-sm position-relative border-0" href="/carrinho" @onclick="CollapseNavbar">
                            <i class="bi bi-cart-fill fs-5"></i>
                            @if (CarrinhoSvc.ContarItens() > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @CarrinhoSvc.ContarItens()
                                </span>
                            }
                        </a>
                    </li>

                    <div class="vr bg-secondary mx-2 d-none d-lg-block" style="height: 25px;"></div>

                    <AuthorizeView>
                        <Authorized>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2"
                                   href="#"
                                   role="button"
                                   @onclick="ToggleMenuUsuario"
                                   @onclick:preventDefault>
                                    <div class="bg-primary rounded-circle d-flex justify-content-center align-items-center" style="width: 30px; height: 30px;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    @context.User.Identity?.Name
                                    @if (context.User.IsInRole("Fornecedor"))
                                    {
                                        <span class="badge bg-warning text-dark ms-1" style="font-size: 0.6em;">PRO</span>
                                    }
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow @(mostrarMenuUsuario ? "show" : "")">

                                    <li><a class="dropdown-item" href="perfil" @onclick="FecharTudo"><i class="bi bi-person-gear me-2"></i>Minha Conta</a></li>

                                    @if (context.User.IsInRole("Fornecedor"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">Área do Fornecedor</h6></li>
                                        <li>
                                            <a class="dropdown-item" href="meus-produtos" @onclick="FecharTudo">
                                                <i class="bi bi-box-seam-fill me-2 text-primary"></i> Gerir Produtos
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="painel-vendas" @onclick="FecharTudo">
                                                <i class="bi bi-graph-up-arrow me-2 text-success"></i> Relatório de Vendas
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item" href="minhas-encomendas" @onclick="FecharTudo">
                                                <i class="bi bi-bag-check me-2"></i> Minhas Compras
                                            </a>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a href="/account/logout" class="dropdown-item text-danger d-flex align-items-center">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sair
                                        </a>
                                    </li>
                                </ul>

                                @* Overlay para fechar menu de utilizador ao clicar fora *@
                                @if (mostrarMenuUsuario)
                                {
                                    <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 900;" @onclick="FecharMenuUsuario"></div>
                                }
                            </li>
                        </Authorized>
                        <NotAuthorized>
                            <li class="nav-item">
                                <a class="nav-link" href="login" @onclick="CollapseNavbar">Entrar</a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-primary btn-sm rounded-pill px-3" href="register" @onclick="CollapseNavbar">Registar</a>
                            </li>
                        </NotAuthorized>
                    </AuthorizeView>

                </ul>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1 bg-light py-4">
        <div class="container">
            @Body
        </div>
    </main>

    <footer class="bg-dark text-white py-3 mt-auto border-top border-secondary">
        <div class="container text-center">
            <small class="text-white-50">&copy; 2024 MyMedia Store. Todos os direitos reservados.</small>
        </div>
    </footer>
</div>

@code {
    // ---------------------------------------------
    // 1. LÓGICA DO MENU HAMBÚRGUER (NAVBAR PRINCIPAL)
    // ---------------------------------------------
    private bool collapseNavMenu = true;

    // Se collapse for true, não tem 'show'. Se for false, adiciona 'show'.
    private string? NavMenuCssClass => collapseNavMenu ? "collapse navbar-collapse" : "collapse navbar-collapse show";

    private void ToggleNavbar()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CollapseNavbar()
    {
        collapseNavMenu = true;
    }

    // ---------------------------------------------
    // 2. LÓGICA DO MENU DE UTILIZADOR (DROPDOWN)
    // ---------------------------------------------
    private bool mostrarMenuUsuario = false;

    private void ToggleMenuUsuario()
    {
        mostrarMenuUsuario = !mostrarMenuUsuario;
    }

    private void FecharMenuUsuario()
    {
        mostrarMenuUsuario = false;
    }

    // Fecha tudo quando clica num link (Útil para mobile)
    private void FecharTudo()
    {
        mostrarMenuUsuario = false;
        collapseNavMenu = true;
    }

    // ---------------------------------------------
    // 3. CARRINHO
    // ---------------------------------------------
    protected override void OnInitialized()
    {
        CarrinhoSvc.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CarrinhoSvc.OnChange -= StateHasChanged;
    }
}