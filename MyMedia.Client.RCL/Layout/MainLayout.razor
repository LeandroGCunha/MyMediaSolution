@inherits LayoutComponentBase
@using MyMedia.Client.RCL.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject CarrinhoService CarrinhoSvc
@inject NavigationManager Nav
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

@namespace MyMedia.Client.RCL.Layout

<style>
    /* --- CUSTOM STYLES --- */

    /* Navbar Preto Profundo */
    .navbar-jet-black {
        background-color: #1a1a1a;
        border-bottom: 3px solid #ffc107;
    }

    /* O Corpo da página fica CLARO */
    .bg-clean-light {
        background-color: #f8f9fa;
    }

    /* --- NOVA ANIMAÇÃO DOS LINKS (Início / Catálogo) --- */
    .nav-link-zoom {
        color: white !important; /* Sempre branco normal */
        font-weight: bold;
        padding: 10px 15px; /* Espaço para respirar */
        transition: all 0.3s ease; /* Suavidade na mudança */
        background-color: transparent !important; /* SEM QUADRADO CINZA */
        display: inline-block; /* Necessário para o zoom funcionar */
    }

        /* O que acontece quando passas o rato: */
        .nav-link-zoom:hover {
            color: #ffc107 !important; /* Fica AMARELO */
            transform: scale(1.1); /* Aumenta 20% (Fica maior) */
            text-shadow: 0 0 10px rgba(255, 193, 7, 0.5); /* Brilho suave */
        }

    /* Botões redondos de ação (Carrinho/Menu) */
    .btn-nav-action {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: rgba(255,255,255,0.1);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        border: none;
    }

        .btn-nav-action:hover {
            background-color: rgba(255,255,255,0.2);
            transform: scale(1.05);
        }
</style>

<div class="page d-flex flex-column min-vh-100 bg-clean-light">

    @* --- NAVBAR PRETA --- *@
    <nav class="navbar navbar-expand-lg navbar-dark navbar-jet-black sticky-top py-2 px-3 shadow">
        <div class="container-fluid">

            @* 1. LOGO *@
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2 me-auto" href="/">
                <i class="bi bi-play-circle-fill text-warning fs-3"></i>
                <span class="text-white tracking-wide" style="font-family: sans-serif; font-weight: 700; margin-right: 15px">MYMEDIA</span>
            </a>

            @* 2. ÍCONES DE AÇÃO (DIREITA) *@
            <div class="d-flex align-items-center gap-3 order-lg-last ms-2">

                @* A. CARRINHO *@
                <a class="position-relative btn-nav-action text-decoration-none" href="/carrinho">
                    <i class="bi bi-cart3 fs-5"></i>
                    @if (CarrinhoSvc.ContarItens() > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-circle bg-danger border border-dark"
                              style="width: 18px; height: 18px; display: flex; justify-content: center; align-items: center; font-size: 0.65rem;">
                            @CarrinhoSvc.ContarItens()
                        </span>
                    }
                </a>

                @* B. PERFIL / LOGIN *@
                <AuthorizeView>
                    <Authorized>
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-decoration-none gap-2"
                               @onclick="ToggleMenuUsuario" @onclick:preventDefault>

                                @{
                                    var fullName = context.User.Identity?.Name ?? "";
                                    var firstName = fullName.Split(' ')[0];
                                    var inicial = firstName.Length > 0 ? firstName.Substring(0, 1).ToUpper() : "U";
                                }

                                <div class="d-none d-sm-block text-end">
                                    <span class="fw-bold text-white" style="font-size: 0.9rem;">@firstName</span>
                                </div>

                                <div class="rounded-circle d-flex justify-content-center align-items-center shadow-sm"
                                     style="width: 38px; height: 38px; background: #ffc107; color: #000; font-weight: 800; border: 2px solid #fff;">
                                    @inicial
                                </div>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow mt-3 @(mostrarMenuUsuario ? "show" : "")"
                                style="position: absolute; right: 0;">
                                <li class="px-3 py-2 border-bottom border-secondary mb-2">
                                    <strong class="text-warning">@fullName</strong>
                                </li>
                                <li><a class="dropdown-item py-2" href="perfil" @onclick="FecharTudo"><i class="bi bi-person me-2"></i>Minha Conta</a></li>
                                @if (context.User.IsInRole("Fornecedor"))
                                {
                                    <li><a class="dropdown-item py-2" href="meus-produtos" @onclick="FecharTudo"><i class="bi bi-box-seam me-2 text-info"></i>Gerir Produtos</a></li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item py-2" href="minhas-encomendas" @onclick="FecharTudo"><i class="bi bi-bag-check me-2 text-success"></i>Minhas Compras</a></li>
                                }
                                <li><hr class="dropdown-divider border-secondary my-2"></li>
                                <li><a href="/account/logout" class="dropdown-item py-2 text-danger fw-bold"><i class="bi bi-box-arrow-right me-2"></i>Sair</a></li>
                            </ul>

                            @if (mostrarMenuUsuario)
                            {
                                <div class="position-fixed top-0 start-0 w-100 h-100" style="z-index: 900;" @onclick="FecharMenuUsuario"></div>
                            }
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login" class="btn btn-outline-light rounded-pill px-3 fw-bold btn-sm">
                            Entrar
                        </a>
                    </NotAuthorized>
                </AuthorizeView>

                @* C. BOTÃO MENU *@
                <button class="navbar-toggler border-0 p-0 ms-1" type="button" @onclick="ToggleNavbar">
                    <i class="bi bi-list fs-1 text-white"></i>
                </button>
            </div>

            @* 3. MENU LATERAL / LINKS (Aqui está a mudança!) *@
            <div class="@NavMenuCssClass w-100" id="navbarStore">

                @* Tirei o fundo cinza daqui e removi as classes bg-dark *@
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 mt-3 mt-lg-0 d-lg-flex flex-lg-row align-items-center">

                    <li class="nav-item">
                        @* Apliquei a classe nav-link-zoom *@
                        <a class="nav-link nav-link-zoom" href="/" @onclick="CollapseNavbar">
                            Início
                        </a>
                    </li>
                    <li class="nav-item">
                        @* Apliquei a classe nav-link-zoom *@
                        <a class="nav-link nav-link-zoom" href="/catalogo" @onclick="CollapseNavbar">
                            Catálogo
                        </a>
                    </li>
                </ul>
            </div>

        </div>
    </nav>

    <main class="flex-grow-1">
        <div class="container py-4">
            @Body
        </div>
    </main>

    <footer class="bg-dark text-white py-3 mt-auto">
        <div class="container text-center">
            <small class="text-white-50">&copy; 2024 MyMedia Store.</small>
        </div>
    </footer>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse navbar-collapse" : "collapse navbar-collapse show";
    private void ToggleNavbar() => collapseNavMenu = !collapseNavMenu;
    private void CollapseNavbar() => collapseNavMenu = true;

    private bool mostrarMenuUsuario = false;
    private void ToggleMenuUsuario() => mostrarMenuUsuario = !mostrarMenuUsuario;
    private void FecharMenuUsuario() => mostrarMenuUsuario = false;
    private void FecharTudo() { mostrarMenuUsuario = false; collapseNavMenu = true; }

    protected override void OnInitialized() => CarrinhoSvc.OnChange += StateHasChanged;
    public void Dispose() => CarrinhoSvc.OnChange -= StateHasChanged;
}