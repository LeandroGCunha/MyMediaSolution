@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3">Olá, <b>@context.User.Identity?.Name</b></span>

                    <form action="Identity/Account/Logout" method="post" class="d-inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="/" />
                        <button type="submit" class="btn btn-link nav-link d-inline">Sair</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="Identity/Account/Login" class="btn btn-link">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

@code {
    // Pequena função auxiliar para mostrar a Role no ecrã (opcional)
    string ObterRole(AuthenticationState context)
    {
        if (context.User.IsInRole("Administrador")) return "Admin";
        if (context.User.IsInRole("Funcionario")) return "Func.";
        return "";
    }
}

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
