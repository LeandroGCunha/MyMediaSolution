@page "/produtos/criar"
@attribute [Authorize(Roles = "Administrador, Funcionario")]
@using MyMedia.Data
@using MyMedia.Data.Entities
@using Microsoft.EntityFrameworkCore
@using System.IO
@inject ApplicationDbContext Context
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment
@rendermode InteractiveServer

<h3>Novo Produto</h3>

<div class="row">
    <div class="col-md-8">
        <EditForm Model="produto" OnValidSubmit="GuardarProduto">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Título:</label>
                <InputText class="form-control" @bind-Value="produto.Titulo" />
            </div>

            <div class="mb-3">
                <label>Descrição Detalhada:</label>
                <InputTextArea class="form-control" @bind-Value="produto.Descricao" />
            </div>

            <div class="mb-3 border p-3 rounded">
                <label class="form-label fw-bold">Imagem do Produto:</label>
                <InputFile OnChange="CarregarImagemPreview" class="form-control" accept=".jpg,.jpeg,.png" />

                @if (!string.IsNullOrEmpty(imagemPreview))
                {
                    <div class="mt-2">
                        <p>Pré-visualização:</p>
                        <img src="@imagemPreview" width="150" class="img-thumbnail" />
                    </div>
                }
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Tipo (Ex: CD, DVD, Livro):</label>
                    <InputText class="form-control" @bind-Value="produto.Tipo" />
                </div>
                <div class="col-md-6 mb-3">
                    <label>Stock Inicial:</label>
                    <InputNumber class="form-control" @bind-Value="produto.Stock" />
                </div>
            </div>

            <div class="mb-3">
                <label>Categoria:</label>
                <InputSelect class="form-select" @bind-Value="produto.CategoriaId">
                    <option value="">-- Selecione uma Categoria --</option>
                    @if (listaCategorias != null)
                    {
                        foreach (var cat in listaCategorias)
                        {
                            <option value="@cat.Id">@cat.Nome</option>
                        }
                    }
                </InputSelect>
            </div>

            <div class="row bg-light p-3 border rounded mb-3">
                <div class="col-md-4">
                    <label>Preço Base (€):</label>
                    <InputNumber class="form-control" @bind-Value="produto.PrecoBase" />
                </div>
                <div class="col-md-4">
                    <label>Margem (Ex: 0.5 = 50%):</label>
                    <InputNumber class="form-control" @bind-Value="produto.MargemLucro" Step="0.01" />
                </div>
                <div class="col-md-4 pt-4">
                    <p>
                        Estimativa Final:
                        <strong class="text-success" style="font-size: 1.2em;">
                            @((produto.PrecoBase + (produto.PrecoBase * produto.MargemLucro)).ToString("C"))
                        </strong>
                    </p>
                </div>
            </div>

            <button type="submit" class="btn btn-success">Guardar Produto</button>
            <a href="/produtos" class="btn btn-secondary">Cancelar</a>
        </EditForm>
    </div>
</div>

@code {
    private Produto produto = new Produto();
    private List<Categoria> listaCategorias = new();

    // Variáveis para a imagem
    private IBrowserFile? ficheiroSelecionado;
    private string? imagemPreview;

    protected override async Task OnInitializedAsync()
    {
        listaCategorias = await Context.Categorias.ToListAsync();
        produto.IsAtivo = true;
        produto.MargemLucro = 0.5m; // Valor inicial sugerido
    }

    // Lógica da Pré-visualização (Segura)
    private async Task CarregarImagemPreview(InputFileChangeEventArgs e)
    {
        ficheiroSelecionado = e.File;
        long maxFileSize = 1024 * 1024 * 5; // 5MB
        var format = "image/png";

        try
        {
            var resizedImage = await ficheiroSelecionado.RequestImageFileAsync(format, 300, 300);
            using (var stream = resizedImage.OpenReadStream(maxFileSize))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                imagemPreview = $"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro imagem: {ex.Message}");
        }
    }

    private async Task GuardarProduto()
    {
        // FASE 1: Preparar dados básicos
        produto.PrecoFinal = produto.PrecoBase + (produto.PrecoBase * produto.MargemLucro);

        // FASE 2: Gravar na BD PRIMEIRO (Para gerar o ID)
        // Nota: Ainda não guardamos a imagem, por isso o ImagemUrl vai null ou vazio
        Context.Produtos.Add(produto);
        await Context.SaveChangesAsync();

        // AGORA JÁ TEMOS UM ID! (ex: produto.Id agora é 15)

        // FASE 3: Se houver imagem, gravamos com o nome correto (15.jpg)
        if (ficheiroSelecionado != null)
        {
            var extensao = Path.GetExtension(ficheiroSelecionado.Name);

            // Usamos o ID que acabámos de gerar
            var nomeFicheiro = $"{produto.Id}{extensao}";

            var pastaImagens = Path.Combine(Environment.WebRootPath, "imagens");
            if (!Directory.Exists(pastaImagens)) Directory.CreateDirectory(pastaImagens);

            var caminhoCompleto = Path.Combine(pastaImagens, nomeFicheiro);

            // Gravar no disco
            await using var stream = new FileStream(caminhoCompleto, FileMode.Create);
            await ficheiroSelecionado.OpenReadStream(5 * 1024 * 1024).CopyToAsync(stream);

            // Atualizar o produto com o caminho da imagem
            produto.ImagemUrl = "/imagens/" + nomeFicheiro;

            // FASE 4: Gravar a alteração da imagem na BD
            Context.Produtos.Update(produto);
            await Context.SaveChangesAsync();
        }

        Navigation.NavigateTo("/produtos");
    }
}