@page "/produtos/criar"
@attribute [Authorize(Roles = "Administrador, Funcionario")]

@using MyMedia.Data
@using MyMedia.Data.Entities
@using Microsoft.EntityFrameworkCore
@using System.IO
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Hosting

@inject ApplicationDbContext Context
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment
@rendermode InteractiveServer

<h3>Novo Produto</h3>

<div class="row">
    <div class="col-md-8">
        <EditForm Model="produto" OnValidSubmit="GuardarProduto">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label>Título:</label>
                <InputText class="form-control" @bind-Value="produto.Titulo" />
            </div>

            <div class="mb-3">
                <label>Descrição Detalhada:</label>
                <InputTextArea class="form-control" @bind-Value="produto.Descricao" rows="4" />
            </div>

            <div class="mb-3 border p-3 rounded bg-light">
                <label class="form-label fw-bold">Imagem do Produto:</label>
                <InputFile OnChange="CarregarImagemPreview" class="form-control" accept=".jpg,.jpeg,.png" />

                @if (!string.IsNullOrEmpty(imagemPreview))
                {
                    <div class="mt-2">
                        <p class="small text-success">Pré-visualização:</p>
                        <img src="@imagemPreview" width="150" class="img-thumbnail" />
                    </div>
                }
                else
                {
                    <div class="mt-2 text-muted small">Nenhuma imagem selecionada.</div>
                }
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Categoria:</label>
                    <InputSelect class="form-select" @bind-Value="produto.CategoriaId">
                        <option value="">-- Selecione uma Categoria --</option>
                        @if (listaCategorias != null)
                        {
                            foreach (var cat in listaCategorias)
                            {
                                <option value="@cat.Id">@cat.Nome</option>
                            }
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="row bg-light p-3 border rounded mb-3">
                <div class="col-md-4 mb-3">
                    <label>Preço Base (€):</label>
                    <InputNumber class="form-control" @bind-Value="produto.PrecoBase" />
                </div>
                <div class="col-md-4 mb-3">
                    <label>Margem (Ex: 0.5 = 50%):</label>
                    <InputNumber class="form-control" @bind-Value="produto.MargemLucro" Step="0.01" />
                </div>
                <div class="col-md-4 mb-3">
                    <label>Stock Inicial:</label>
                    <InputNumber class="form-control" @bind-Value="produto.Stock" />
                </div>

                <div class="col-12 mt-2">
                    <p>
                        Estimativa Final:
                        <strong class="text-success" style="font-size: 1.2em;">
                            @((produto.PrecoBase + (produto.PrecoBase * produto.MargemLucro)).ToString("C"))
                        </strong>
                    </p>
                </div>

                @* 👇 CORREÇÃO: Substituição do Checkbox IsAtivo pelo Select de Estado *@
                <div class="col-12 mt-3">
                    <label class="fw-bold">Estado Inicial:</label>
                    <InputSelect class="form-select" @bind-Value="produto.Estado">
                        <option value="@EstadoProduto.Ativo">🟢 Ativo (Visível na Loja)</option>
                        <option value="@EstadoProduto.Pendente">🟡 Pendente (Rascunho)</option>
                        <option value="@EstadoProduto.Pausado">⚪ Pausado</option>
                    </InputSelect>
                </div>
            </div>

            <button type="submit" class="btn btn-success">Criar Produto</button>
            <a href="/produtos" class="btn btn-secondary ms-2">Cancelar</a>
        </EditForm>
    </div>
</div>

@code {
    private Produto produto = new Produto();
    private List<Categoria> listaCategorias = new();

    // Variáveis para a imagem
    private IBrowserFile? ficheiroSelecionado;
    private string? imagemPreview;

    protected override async Task OnInitializedAsync()
    {
        listaCategorias = await Context.Categorias.AsNoTracking().ToListAsync();

        // 👇 CORREÇÃO: Inicializar com Enum (Por defeito Ativo para Admin)
        produto.Estado = EstadoProduto.Ativo;

        produto.MargemLucro = 0.5m;
    }

    // Lógica da Pré-visualização (Segura)
    private async Task CarregarImagemPreview(InputFileChangeEventArgs e)
    {
        ficheiroSelecionado = e.File;
        long maxFileSize = 1024 * 1024 * 5; // 5MB
        var format = "image/png";

        try
        {
            var resizedImage = await ficheiroSelecionado.RequestImageFileAsync(format, 300, 300);
            using (var stream = resizedImage.OpenReadStream(maxFileSize))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                imagemPreview = $"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro imagem: {ex.Message}");
        }
    }

    private async Task GuardarProduto()
    {
        // FASE 1: Preparar dados básicos
        produto.PrecoFinal = produto.PrecoBase + (produto.PrecoBase * produto.MargemLucro);

        // Forçar ID a 0 para evitar erro "Identity Insert"
        produto.Id = 0;

        // Se for o Admin a criar, não tem FornecedorId (fica NULL)
        produto.FornecedorId = null;

        // FASE 2: Gravar na BD PRIMEIRO (Para gerar o ID)
        Context.Produtos.Add(produto);
        await Context.SaveChangesAsync();

        // FASE 3: Se houver imagem, gravamos na API
        if (ficheiroSelecionado != null)
        {
            try
            {
                // Gravar na pasta da API
                var pastaApi = Path.GetFullPath(Path.Combine(Environment.ContentRootPath, "..", "MyMedia.API", "wwwroot"));
                var pastaImagensApi = Path.Combine(pastaApi, "imagens");

                if (!Directory.Exists(pastaImagensApi)) Directory.CreateDirectory(pastaImagensApi);

                var extensao = Path.GetExtension(ficheiroSelecionado.Name);
                var nomeFicheiro = $"{produto.Id}{extensao}";
                var caminhoCompleto = Path.Combine(pastaImagensApi, nomeFicheiro);

                // Gravar no disco
                await using var stream = new FileStream(caminhoCompleto, FileMode.Create);
                await ficheiroSelecionado.OpenReadStream(5 * 1024 * 1024).CopyToAsync(stream);

                // Atualizar o produto com o caminho da imagem e timestamp
                produto.ImagemUrl = $"imagens/{nomeFicheiro}?v={DateTime.Now.Ticks}";

                // FASE 4: Gravar a alteração da imagem na BD
                Context.Produtos.Update(produto);
                await Context.SaveChangesAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine("Erro ao gravar imagem: " + ex.Message);
            }
        }

        Navigation.NavigateTo("/produtos");
    }
}