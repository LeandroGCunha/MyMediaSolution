@page "/produtos/editar/{id:int}"
@attribute [Authorize(Roles = "Administrador, Funcionario")]
@using MyMedia.Data
@using MyMedia.Data.Entities
@using Microsoft.EntityFrameworkCore
@using System.IO
@inject ApplicationDbContext Context
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment
@rendermode InteractiveServer

<h3>Editar Produto</h3>

@if (produto == null)
{
    <p><em>A carregar dados...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <EditForm Model="produto" OnValidSubmit="AtualizarProduto">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label>Título:</label>
                    <InputText class="form-control" @bind-Value="produto.Titulo" />
                </div>

                <div class="mb-3">
                    <label>Descrição:</label>
                    <InputTextArea class="form-control" @bind-Value="produto.Descricao" rows="4" />
                </div>

                <div class="mb-3 border p-3 rounded bg-light">
                    <label class="form-label fw-bold">Imagem do Produto:</label>
                    <div class="row">
                        <div class="col-md-4 text-center mb-3">
                            @if (!string.IsNullOrEmpty(imagemPreview))
                            {
                                <p class="small text-success">Nova Imagem (Pré-visualização):</p>
                                <img src="@imagemPreview" width="150" class="img-thumbnail border-success" />
                            }
                            else if (!string.IsNullOrEmpty(produto.ImagemUrl))
                            {
                                <p class="small text-muted">Imagem Atual:</p>
                                @* 👇 1. CORREÇÃO VISUAL: Apontar para a API *@
                                <img src="@($"https://localhost:7198/{produto.ImagemUrl}")" width="150" class="img-thumbnail" />
                            }
                            else
                            {
                                <div class="border p-3 text-muted">Sem Imagem</div>
                            }
                        </div>
                        <div class="col-md-8 align-self-center">
                            <label class="form-label">Escolher Nova Imagem:</label>
                            <InputFile OnChange="CarregarImagemPreview" class="form-control" accept=".jpg,.jpeg,.png" />
                            <small class="text-muted">Deixe vazio para manter a imagem atual.</small>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Categoria:</label>
                        <InputSelect class="form-select" @bind-Value="produto.CategoriaId">
                            <option value="">-- Selecione --</option>
                            @foreach (var cat in listaCategorias)
                            {
                                <option value="@cat.Id">@cat.Nome</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="row bg-light p-3 border rounded mb-3">
                    <div class="col-md-4 mb-3">
                        <label>Preço Base (€):</label>
                        <InputNumber class="form-control" @bind-Value="produto.PrecoBase" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Margem (0.5 = 50%):</label>
                        <InputNumber class="form-control" @bind-Value="produto.MargemLucro" Step="0.01" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Stock:</label>
                        <InputNumber class="form-control" @bind-Value="produto.Stock" />
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="produto.IsAtivo" id="flexSwitchCheckChecked" />
                            <label class="form-check-label fw-bold" for="flexSwitchCheckChecked">
                                @(produto.IsAtivo ? "Produto Ativo e Visível" : "Produto Inativo (Oculto)")
                            </label>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Guardar Alterações</button>
                <a href="/produtos" class="btn btn-secondary ms-2">Cancelar</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Produto? produto;
    private List<Categoria> listaCategorias = new();

    // Variáveis para controlar o upload da nova imagem
    private IBrowserFile? novoFicheiroSelecionado;
    private string? imagemPreview;

    protected override async Task OnInitializedAsync()
    {
        listaCategorias = await Context.Categorias.AsNoTracking().ToListAsync();
        produto = await Context.Produtos.FindAsync(Id);

        if (produto == null)
        {
            Navigation.NavigateTo("/produtos");
        }
    }

    // --- LÓGICA DA PRÉ-VISUALIZAÇÃO ---
    private async Task CarregarImagemPreview(InputFileChangeEventArgs e)
    {
        novoFicheiroSelecionado = e.File;

        long maxFileSize = 1024 * 1024 * 5; // 5MB
        var format = "image/png";

        try
        {
            var resizedImage = await novoFicheiroSelecionado.RequestImageFileAsync(format, 300, 300);
            using (var stream = resizedImage.OpenReadStream(maxFileSize))
            using (var ms = new MemoryStream())
            {
                await stream.CopyToAsync(ms);
                imagemPreview = $"data:{format};base64,{Convert.ToBase64String(ms.ToArray())}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro na pré-visualização: {ex.Message}");
        }
    }

    private async Task AtualizarProduto()
    {
        if (produto == null) return;

        // --- GRAVAR NOVA IMAGEM (Se houver) ---
        if (novoFicheiroSelecionado != null)
        {
            // 👇 DEFINIR A PASTA DE DESTINO CORRETA (NA API)
            // Sai do Admin (..) -> Entra na API -> wwwroot
            var pastaApi = Path.GetFullPath(Path.Combine(Environment.ContentRootPath, "..", "MyMedia.API", "wwwroot"));
            var pastaImagensApi = Path.Combine(pastaApi, "imagens");

            // Garante que a pasta existe na API
            if (!Directory.Exists(pastaImagensApi)) Directory.CreateDirectory(pastaImagensApi);

            // 1. APAGAR IMAGEM ANTIGA DA API
            if (!string.IsNullOrEmpty(produto.ImagemUrl))
            {
                // Limpa o URL para ficar apenas o nome do ficheiro (ex: 15.png)
                var nomeFicheiroAntigo = Path.GetFileName(produto.ImagemUrl.Split('?')[0]);
                var caminhoAntigo = Path.Combine(pastaImagensApi, nomeFicheiroAntigo);

                if (File.Exists(caminhoAntigo))
                {
                    try { File.Delete(caminhoAntigo); } catch { }
                }
            }

            // 2. GRAVAR NOVA IMAGEM NA API
            var extensao = Path.GetExtension(novoFicheiroSelecionado.Name);
            var nomeFicheiroNovo = $"{produto.Id}{extensao}"; // Ex: 15.png
            var caminhoCompleto = Path.Combine(pastaImagensApi, nomeFicheiroNovo);

            await using var stream = new FileStream(caminhoCompleto, FileMode.Create);
            await novoFicheiroSelecionado.OpenReadStream(5 * 1024 * 1024).CopyToAsync(stream);

            // 4. Atualizar o URL na BD
            // Nota: O caminho começa com "imagens/" porque na API a pasta "wwwroot" é a raiz
            produto.ImagemUrl = $"imagens/{nomeFicheiroNovo}?v={DateTime.Now.Ticks}";
        }

        // Recalcular Preço
        produto.PrecoFinal = produto.PrecoBase + (produto.PrecoBase * produto.MargemLucro);

        Context.Produtos.Update(produto);
        await Context.SaveChangesAsync();

        Navigation.NavigateTo("/produtos");
    }
}