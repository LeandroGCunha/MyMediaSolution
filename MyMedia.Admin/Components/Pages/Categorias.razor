@page "/categorias"
@attribute [Authorize(Roles = "Administrador, Funcionario")]
@using Microsoft.EntityFrameworkCore
@using MyMedia.Data
@using MyMedia.Data.Entities
@inject ApplicationDbContext Context
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<h3>Gestão de Categorias</h3>

<div class="mb-3">
    <a href="/categorias/criar" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nova Categoria
    </a>
</div>

@if (listaCategorias == null)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">A carregar...</span>
    </div>
}
else if (!listaCategorias.Any())
{
    <div class="alert alert-warning">Não existem categorias registadas.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>Categoria Mãe</th>
                <th>Descrição</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in listaCategorias)
            {
                <tr>
                    <td><strong>@cat.Nome</strong></td>
                    <td>
                        @if (cat.CategoriaPai != null)
                        {
                            <i class="bi bi-arrow-return-right me-1"></i> 
                            <span class="text-muted">@cat.CategoriaPai.Nome</span>
                        }
                        else
                        {
                            <span class="text-muted">- Principal -</span>
                        }
                    </td>
                    <td>
                        @if (string.IsNullOrEmpty(cat.Descricao))
                        {
                            <span class="text-muted small">N/A</span>
                        }
                        else
                        {
                            @cat.Descricao
                        }
                    </td>
                    <td>
                        @* Botões iguais à página de Produtos *@
                        <a href="/categorias/EditarCategoria/@cat.Id" class="btn btn-sm btn-outline-primary me-2" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ApagarCategoria(cat)" title="Apagar">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Categoria>? listaCategorias;

    protected override async Task OnInitializedAsync()
    {
        await CarregarCategorias();
    }

    private async Task CarregarCategorias()
    {
        // Precisamos do Include para mostrar o nome da Categoria Mãe
        listaCategorias = await Context.Categorias
            .Include(c => c.CategoriaPai)
            .AsNoTracking()
            .ToListAsync();
    }

    private async Task ApagarCategoria(Categoria cat)
    {
        bool confirmacao = await JS.InvokeAsync<bool>("confirm", $"Tem a certeza que quer apagar a categoria '{cat.Nome}'?");

        if (!confirmacao) return;

        try
        {
            // Busca a categoria à BD para garantir que existe antes de apagar
            var catParaApagar = await Context.Categorias.FindAsync(cat.Id);

            if (catParaApagar != null)
            {
                Context.Categorias.Remove(catParaApagar);
                await Context.SaveChangesAsync();

                // Recarrega a lista
                await CarregarCategorias();
            }
        }
        catch (Exception)
        {
            // Erro comum: Tentar apagar categoria que tem produtos ou subcategorias
            await JS.InvokeVoidAsync("alert", "ERRO: Não é possível apagar esta categoria porque ela está a ser usada (tem produtos ou subcategorias).");
        }
    }
}