@page "/categorias"
@attribute [Authorize(Roles = "Administrador, Funcionario")]
@using Microsoft.EntityFrameworkCore
@using MyMedia.Data
@using MyMedia.Data.Entities
@inject ApplicationDbContext Context
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<h3>Gestão de Categorias</h3>

<div class="mb-3">
    <a href="/categorias/criar" class="btn btn-primary">Nova Categoria</a>
</div>

@if (listaCategorias == null)
{
    <p><em>A carregar dados...</em></p>
}
else if (!listaCategorias.Any())
{
    <p>Não existem categorias registadas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Categoria Mãe</th>
                <th>Descrição</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in listaCategorias)
            {
                <tr>
                    <td>@cat.Id</td>
                    <td>@cat.Nome</td>
                    <td>
                        @(cat.CategoriaPai?.Nome ?? "- Principal -")
                    </td>
                    <td>@cat.Descricao</td>
                    <td>
                        <a href="/categorias/EditarCategoria/@cat.Id" class="btn btn-sm btn-warning">Editar</a>

                        <button class="btn btn-sm btn-danger" @onclick="() => ApagarCategoria(cat)">
                            Apagar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Categoria>? listaCategorias;

    protected override async Task OnInitializedAsync()
    {
        await CarregarCategorias();
    }

    private async Task CarregarCategorias()
    {
        listaCategorias = await Context.Categorias.ToListAsync();
    }

    private async Task ApagarCategoria(Categoria cat)
    {
        // 1. Pergunta de confirmação (JavaScript)
        bool confirmacao = await JS.InvokeAsync<bool>("confirm", $"Tem a certeza que quer apagar a categoria '{cat.Nome}'?");

        if (!confirmacao) return; // Se disser "Cancelar", sai daqui.

        try
        {
            // 2. Remove do Contexto
            Context.Categorias.Remove(cat);

            // 3. Tenta gravar na BD
            await Context.SaveChangesAsync();

            // 4. Se correu bem, atualiza a lista no ecrã sem recarregar a página
            listaCategorias.Remove(cat);
        }
        catch (Exception)
        {
            // 5. Se der erro (ex: tem subcategorias), mostra aviso
            await JS.InvokeVoidAsync("alert", "ERRO: Não é possível apagar esta categoria. Verifique se ela tem subcategorias associadas.");
        }
    }
}