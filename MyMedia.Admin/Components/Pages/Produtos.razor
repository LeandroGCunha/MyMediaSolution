@page "/produtos"
@attribute [Authorize(Roles = "Administrador, Funcionario")]

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.EntityFrameworkCore
@using MyMedia.Data
@using MyMedia.Data.Entities
@using System.IO
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Context
@inject IJSRuntime JS
@inject IWebHostEnvironment Environment
@rendermode InteractiveServer

<h3>Gestão de Produtos</h3>

<div class="card mb-4">
    <div class="card-header bg-light fw-bold">Filtros e Pesquisa</div>
    <div class="card-body">
        <div class="row g-3">
            @* 1. FILTRO DE TEXTO *@
            <div class="col-md-3">
                <input type="text" class="form-control" placeholder="Pesquisar título..."
                       @bind="filtroTexto" @bind:event="oninput" @onkeyup="CarregarProdutos" />
            </div>

            @* 2. FILTRO DE CATEGORIA *@
            <div class="col-md-2">
                <select class="form-select" @bind="filtroCategoriaId" @bind:after="CarregarProdutos">
                    <option value="0">Todas as Categorias</option>
                    @foreach (var cat in listaCategorias)
                    {
                        <option value="@cat.Id">@cat.Nome</option>
                    }
                </select>
            </div>

            @* 3. FILTRO DE ESTADO (AGORA COM ENUM) *@
            <div class="col-md-2">
                <select class="form-select" @bind="filtroEstado" @bind:after="CarregarProdutos">
                    <option value="">Todos os Estados</option>
                    <option value="Pendente">🟡 Pendente</option>
                    <option value="Ativo">🟢 Ativo</option>
                    <option value="Pausado">⚪ Pausado</option>
                    <option value="Rejeitado">🔴 Rejeitado</option>
                </select>
            </div>

            @* 4. FILTRO DE FORNECEDOR *@
            <div class="col-md-3">
                <select class="form-select" @bind="filtroFornecedorId" @bind:after="CarregarProdutos">
                    <option value="">Todos os Fornecedores</option>
                    <option value="Admin">Apenas Admin (Loja)</option>
                    @foreach (var f in listaFornecedores)
                    {
                        <option value="@f.Id">@f.NomeCompleto</option>
                    }
                </select>
            </div>

            <div class="col-md-2 text-end">
                <a href="/produtos/criar" class="btn btn-primary w-100">
                    <i class="bi bi-plus-lg"></i> Novo
                </a>
            </div>
        </div>
    </div>
</div>

@if (listaProdutos == null)
{
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">A carregar...</span>
    </div>
}
else if (!listaProdutos.Any())
{
    <div class="alert alert-warning">Não foram encontrados produtos com estes filtros.</div>
}
else
{
    <table class="table table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th style="cursor: pointer" @onclick='() => Ordenar("Titulo")'>
                    Título @IconeOrdenacao("Titulo")
                </th>
                <th style="cursor: pointer" @onclick='() => Ordenar("Categoria")'>
                    Categoria @IconeOrdenacao("Categoria")
                </th>
                <th>Fornecedor</th>
                <th style="cursor: pointer" @onclick='() => Ordenar("Preco")'>
                    Preço @IconeOrdenacao("Preco")
                </th>
                <th>Stock</th>
                <th>Imagem</th>
                <th>Estado</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in listaProdutos)
            {
                <tr>
                    <td>@p.Titulo</td>
                    <td>
                        <span class="badge bg-secondary">@p.Categoria?.Nome</span>
                    </td>

                    @* LÓGICA DO FORNECEDOR VS ADMIN *@
                    <td>
                        @if (p.Fornecedor != null)
                        {
                            <span class="text-primary fw-bold"><i class="bi bi-person"></i> @p.Fornecedor.NomeCompleto</span>
                        }
                        else
                        {
                            <span class="text-dark fw-bold"><i class="bi bi-shop"></i> Administrador</span>
                        }
                    </td>

                    <td><strong>@p.PrecoFinal.ToString("C")</strong></td>
                    <td>@p.Stock</td>
                    <td>
                        @if (!string.IsNullOrEmpty(p.ImagemUrl))
                        {
                            @* Ajusta o URL base se necessário *@
                            <img src="@($"https://localhost:7198/{p.ImagemUrl}")"
                                 width="40" height="40" class="rounded border" style="object-fit:cover" />
                        }
                        else
                        {
                            <small class="text-muted">N/A</small>
                        }
                    </td>

                    @* 👇 CORREÇÃO VISUAL: USAR O ENUM *@
                    <td>
                        @switch (p.Estado)
                        {
                            case EstadoProduto.Ativo:
                                <span class="badge bg-success">Ativo</span>
                                break;
                            case EstadoProduto.Pendente:
                                <span class="badge bg-warning text-dark">Pendente</span>
                                break;
                            case EstadoProduto.Pausado:
                                <span class="badge bg-secondary">Pausado</span>
                                break;
                            case EstadoProduto.Rejeitado:
                                <span class="badge bg-danger">Rejeitado</span>
                                break;
                            default:
                                <span class="badge bg-light text-dark">@p.Estado</span>
                                break;
                        }
                    </td>

                    <td>
                        <a href="/produtos/editar/@p.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ApagarProduto(p)" title="Apagar">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* PAGINAÇÃO *@
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span>Página @paginaAtual de @totalPaginas (Total: @totalItems items)</span>
        <div>
            <button class="btn btn-outline-secondary btn-sm" @onclick="PaginaAnterior" disabled="@(paginaAtual == 1)">
                Anterior
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="PaginaProxima" disabled="@(paginaAtual == totalPaginas)">
                Próximo
            </button>
        </div>
    </div>
}

@code {
    private List<Produto>? listaProdutos;
    private List<Categoria> listaCategorias = new();
    private List<ApplicationUser> listaFornecedores = new();

    private string filtroTexto = "";
    private int filtroCategoriaId = 0;
    private string filtroEstado = ""; // Guarda o texto "Ativo", "Pendente", etc.
    private string filtroFornecedorId = "";

    private int paginaAtual = 1;
    private int tamanhoPagina = 5;
    private int totalItems = 0;
    private int totalPaginas => (int)Math.Ceiling((double)totalItems / tamanhoPagina);

    private string colunaOrdenacao = "Titulo";
    private bool ordemAscendente = true;

    protected override async Task OnInitializedAsync()
    {
        listaCategorias = await Context.Categorias.ToListAsync();
        var usersFornecedores = await UserManager.GetUsersInRoleAsync("Fornecedor");
        listaFornecedores = usersFornecedores.ToList();
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        var query = Context.Produtos
            .Include(p => p.Categoria)
            .Include(p => p.Fornecedor)
            .AsQueryable();

        // --- FILTROS ---
        if (!string.IsNullOrWhiteSpace(filtroTexto))
        {
            query = query.Where(p => p.Titulo.Contains(filtroTexto));
        }

        if (filtroCategoriaId > 0)
        {
            var idsPermitidos = ObterIdsCategoriaEFilhos(filtroCategoriaId);
            query = query.Where(p => p.CategoriaId.HasValue && idsPermitidos.Contains(p.CategoriaId.Value));
        }

        // 👇 CORREÇÃO DO FILTRO DE ESTADO (C#)
        if (!string.IsNullOrEmpty(filtroEstado))
        {
            if (Enum.TryParse<EstadoProduto>(filtroEstado, out var estadoEnum))
            {
                // Converteu com sucesso a string "Ativo" para o Enum Ativo
                query = query.Where(p => p.Estado == estadoEnum);
            }
        }

        if (!string.IsNullOrEmpty(filtroFornecedorId))
        {
            if (filtroFornecedorId == "Admin")
                query = query.Where(p => p.FornecedorId == null);
            else
                query = query.Where(p => p.FornecedorId == filtroFornecedorId);
        }

        // --- ORDENAÇÃO ---
        switch (colunaOrdenacao)
        {
            case "Titulo":
                query = ordemAscendente ? query.OrderBy(p => p.Titulo) : query.OrderByDescending(p => p.Titulo);
                break;
            case "Categoria":
                query = ordemAscendente ? query.OrderBy(p => p.Categoria.Nome) : query.OrderByDescending(p => p.Categoria.Nome);
                break;
            case "Preco":
                query = ordemAscendente ? query.OrderBy(p => p.PrecoFinal) : query.OrderByDescending(p => p.PrecoFinal);
                break;
            default:
                query = query.OrderBy(p => p.Id);
                break;
        }

        // --- PAGINAÇÃO ---
        totalItems = await query.CountAsync();
        if (paginaAtual > totalPaginas && totalPaginas > 0) paginaAtual = 1;

        listaProdutos = await query
            .Skip((paginaAtual - 1) * tamanhoPagina)
            .Take(tamanhoPagina)
            .AsNoTracking()
            .ToListAsync();
    }

    private async Task Ordenar(string coluna)
    {
        if (colunaOrdenacao == coluna) ordemAscendente = !ordemAscendente;
        else
        {
            colunaOrdenacao = coluna;
            ordemAscendente = true;
        }
        await CarregarProdutos();
    }

    private MarkupString IconeOrdenacao(string coluna)
    {
        if (colunaOrdenacao != coluna) return new MarkupString("");
        return new MarkupString(ordemAscendente ? "<i class='bi bi-arrow-down'></i>" : "<i class='bi bi-arrow-up'></i>");
    }

    private async Task PaginaAnterior()
    {
        if (paginaAtual > 1) { paginaAtual--; await CarregarProdutos(); }
    }

    private async Task PaginaProxima()
    {
        if (paginaAtual < totalPaginas) { paginaAtual++; await CarregarProdutos(); }
    }

    private async Task ApagarProduto(Produto p)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", $"Tem a certeza que quer apagar '{p.Titulo}'?");

        if (confirmar)
        {
            try
            {
                var produtoParaApagar = await Context.Produtos.FindAsync(p.Id);

                if (produtoParaApagar != null)
                {
                    if (!string.IsNullOrEmpty(produtoParaApagar.ImagemUrl))
                    {
                        try
                        {
                            var pastaApi = Path.GetFullPath(Path.Combine(Environment.ContentRootPath, "..", "MyMedia.API", "wwwroot"));
                            var urlLimpo = produtoParaApagar.ImagemUrl.Split('?')[0];
                            var caminhoRelativo = urlLimpo.TrimStart('/').Replace('/', Path.DirectorySeparatorChar);
                            var caminhoImagem = Path.Combine(pastaApi, caminhoRelativo);
                            if (File.Exists(caminhoImagem)) File.Delete(caminhoImagem);
                        }
                        catch { }
                    }
                    Context.Produtos.Remove(produtoParaApagar);
                    await Context.SaveChangesAsync();
                    await CarregarProdutos();
                }
            }
            catch (Exception)
            {
                await JS.InvokeVoidAsync("alert", "Erro ao apagar produto. Verifique se existem encomendas associadas.");
            }
        }
    }

    private List<int> ObterIdsCategoriaEFilhos(int categoriaId)
    {
        var listaIds = new List<int> { categoriaId };
        var filhos = listaCategorias.Where(c => c.CategoriaPaiId == categoriaId).ToList();
        foreach (var filho in filhos)
        {
            listaIds.AddRange(ObterIdsCategoriaEFilhos(filho.Id));
        }
        return listaIds;
    }
}