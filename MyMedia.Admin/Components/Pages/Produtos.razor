@page "/produtos"
@attribute [Authorize(Roles = "Administrador, Funcionario")]
@using Microsoft.EntityFrameworkCore
@using MyMedia.Data
@using MyMedia.Data.Entities
@inject ApplicationDbContext Context
@inject IJSRuntime JS  // <--- Injeção necessária para o Popup de confirmação
@inject IWebHostEnvironment Environment
@rendermode InteractiveServer


<h3>Gestão de Produtos</h3>

<div class="mb-3">
    <a href="/produtos/criar" class="btn btn-primary">Novo Produto</a>
</div>

@if (listaProdutos == null)
{
        <p>A carregar...</p>
}
else if (!listaProdutos.Any())
{
        <p>Não há produtos registados.</p>
}
else
{
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    
                    <th>Título</th>
                    <th>Categoria</th>
                    <th>Preço Final</th>
                    <th>Stock</th>
                        <th>imagem</th>
                    <th>Estado</th>
                    <th>Ações</th> </tr>
            </thead>
            <tbody>
                @foreach (var p in listaProdutos)
                {
                        <tr>
                            <td>@p.Titulo</td>
                            <td>@p.Categoria?.Nome</td>
                            <td><strong>@p.PrecoFinal.ToString("C")</strong></td>
                            <td>@p.Stock</td>
                                    <td>
            @if (!string.IsNullOrEmpty(p.ImagemUrl))
            {
                    <img src="@p.ImagemUrl" width="50" height="50" style="object-fit:cover" class="rounded" />
            }
            else
            {
                    <span class="text-muted">Sem foto</span>
            }
        </td>
                            <td>
                                @if (p.IsAtivo)
                                {
                                    <span class="badge bg-success">Ativo</span>
                                }
                                else
                                {

                                    <span class="badge bg-warning text-dark">Pendente</span>
                                }
                            </td>
                            <td>
                                <a href="/produtos/editar/@p.Id" class="btn btn-sm btn-outline-primary me-2">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>

                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ApagarProduto(p)">
                                    <i class="bi bi-trash"></i> Apagar
                                </button>
                            </td>
                        </tr>
                }
            </tbody>
        </table>
}

@code {
    private List<Produto>? listaProdutos;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        listaProdutos = await Context.Produtos
            .Include(p => p.Categoria)
            .AsNoTracking()
            .ToListAsync();
    }

    private async Task ApagarProduto(Produto p)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", $"Tem a certeza que quer apagar '{p.Titulo}' e a respetiva imagem?");

        if (confirmar)
        {
            try
            {
                var produtoParaApagar = await Context.Produtos.FindAsync(p.Id);

                if (produtoParaApagar != null)
                {
                    // --- APAGAR IMAGEM DO DISCO ---
                    if (!string.IsNullOrEmpty(produtoParaApagar.ImagemUrl))
                    {
                        // 1. Converter o URL (/imagens/15.jpg) para caminho do Windows (C:\...\wwwroot\imagens\15.jpg)
                        // O TrimStart('/') remove a primeira barra para o Path.Combine funcionar bem
                        var caminhoImagem = Path.Combine(Environment.WebRootPath, produtoParaApagar.ImagemUrl.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));

                        // 2. Verificar se existe e apagar
                        if (File.Exists(caminhoImagem))
                        {
                            try
                            {
                                File.Delete(caminhoImagem);
                            }
                            catch
                            {
                                // Se falhar ao apagar o ficheiro (ex: ficheiro aberto),
                                // ignoramos para não impedir de apagar o produto da BD.
                                Console.WriteLine("A imagem não pôde ser apagada, mas o produto será removido.");
                            }
                        }
                    }

                    // --- APAGAR DA BD ---
                    Context.Produtos.Remove(produtoParaApagar);
                    await Context.SaveChangesAsync();

                    await CarregarProdutos(); // Atualiza a lista no ecrã
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro ao apagar: {ex.Message}");
            }
        }
    }
}