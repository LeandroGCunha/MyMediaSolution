@page "/produtos"
@attribute [Authorize(Roles = "Administrador, Funcionario")]
@using Microsoft.EntityFrameworkCore
@using MyMedia.Data
@using MyMedia.Data.Entities
@using System.IO
@inject ApplicationDbContext Context
@inject IJSRuntime JS
@inject IWebHostEnvironment Environment
@rendermode InteractiveServer

<h3>Gestão de Produtos</h3>

<div class="mb-3">
    <a href="/produtos/criar" class="btn btn-primary">Novo Produto</a>
</div>

@if (listaProdutos == null)
{
    <p>A carregar...</p>
}
else if (!listaProdutos.Any())
{
    <p>Não há produtos registados.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Título</th>
                <th>Categoria</th>
                <th>Preço Final</th>
                <th>Stock</th>
                <th>Imagem</th>
                <th>Estado</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in listaProdutos)
            {
                <tr>
                    <td>@p.Titulo</td>
                    <td>@p.Categoria?.Nome</td>
                    <td><strong>@p.PrecoFinal.ToString("C")</strong></td>
                    <td>@p.Stock</td>
                    <td>
                        @if (!string.IsNullOrEmpty(p.ImagemUrl))
                        {
                            <img src="@($"https://localhost:7198/{p.ImagemUrl}")"
                                 width="50" height="50"
                                 style="object-fit:cover"
                                 class="rounded"
                                 alt="Imagem do produto" />
                        }
                        else
                        {
                            <span class="text-muted">Sem foto</span>
                        }
                    </td>
                    <td>
                        @if (p.IsAtivo)
                        {
                            <span class="badge bg-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pendente</span>
                        }
                    </td>
                    <td>
                        <a href="/produtos/editar/@p.Id" class="btn btn-sm btn-outline-primary me-2">
                            <i class="bi bi-pencil"></i> Editar
                        </a>

                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ApagarProduto(p)">
                            <i class="bi bi-trash"></i> Apagar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Produto>? listaProdutos;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        listaProdutos = await Context.Produtos
            .Include(p => p.Categoria)
            .AsNoTracking()
            .ToListAsync();
    }

    private async Task ApagarProduto(Produto p)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", $"Tem a certeza que quer apagar '{p.Titulo}'?");

        if (confirmar)
        {
            try
            {
                var produtoParaApagar = await Context.Produtos.FindAsync(p.Id);

                if (produtoParaApagar != null)
                {
                    // --- CORREÇÃO DO APAGAR ---
                    if (!string.IsNullOrEmpty(produtoParaApagar.ImagemUrl))
                    {
                        try
                        {
                            // 1. Caminho para a pasta da API
                            var pastaApi = Path.GetFullPath(Path.Combine(Environment.ContentRootPath, "..", "MyMedia.API", "wwwroot"));

                            // 2. IMPORTANTE: Limpar o "?v=..." do URL
                            // Se o URL for "imagens/15.png?v=123", isto pega só no "imagens/15.png"
                            var urlLimpo = produtoParaApagar.ImagemUrl.Split('?')[0];

                            // 3. Montar o caminho final
                            // Convertemos as barras para o formato do Windows
                            var caminhoRelativo = urlLimpo.TrimStart('/').Replace('/', Path.DirectorySeparatorChar);
                            var caminhoImagem = Path.Combine(pastaApi, caminhoRelativo);

                            // Debug: Escreve na consola para veres onde ele está a procurar (Vê na janela Output do VS)
                            Console.WriteLine($"A tentar apagar: {caminhoImagem}");

                            if (File.Exists(caminhoImagem))
                            {
                                File.Delete(caminhoImagem);
                                Console.WriteLine("Ficheiro apagado com sucesso.");
                            }
                            else
                            {
                                Console.WriteLine("Ficheiro não encontrado no disco.");
                            }
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine("Erro ao apagar ficheiro físico: " + ex.Message);
                        }
                    }

                    // --- APAGAR DA BD ---
                    Context.Produtos.Remove(produtoParaApagar);
                    await Context.SaveChangesAsync();

                    await CarregarProdutos();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro ao apagar: {ex.Message}");
                await JS.InvokeVoidAsync("alert", "Erro ao apagar produto. Verifique se existem encomendas associadas.");
            }
        }
    }
}