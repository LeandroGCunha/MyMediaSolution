@page "/categorias/criar"
@attribute [Authorize(Roles = "Administrador, Funcionario")]
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MyMedia.Data
@using MyMedia.Data.Entities
@inject ApplicationDbContext Context
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3>Nova Categoria</h3>

<div class="row">
    <div class="col-md-6">
        <EditForm Model="categoria" OnValidSubmit="GuardarCategoria">
            <DataAnnotationsValidator />

            @* 1. NOME *@
            <div class="mb-3">
                <label class="form-label">Nome da Categoria:</label>
                <InputText class="form-control" @bind-Value="categoria.Nome" placeholder="Ex: Portáteis" />
            </div>

            @* 2. CATEGORIA MÃE (DROPDOWN) *@
            <div class="mb-3">
                <label class="form-label">Pertence a alguma Categoria?</label>

                <InputSelect class="form-select" @bind-Value="categoria.CategoriaPaiId">
                    <option value="">-- Não (É uma Categoria Principal) --</option>

                    @if (listaExistentes != null)
                    {
                        @foreach (var cat in listaExistentes)
                        {
                            <option value="@cat.Id">@cat.Nome</option>
                        }
                    }
                </InputSelect>
                <small class="text-muted">Se escolheres uma, esta será uma Subcategoria.</small>
            </div>

            @* 3. DESCRIÇÃO *@
            <div class="mb-3">
                <label class="form-label">Descrição:</label>
                <InputTextArea class="form-control" @bind-Value="categoria.Descricao" />
            </div>

            <button type="submit" class="btn btn-success">Guardar</button>
            <a href="/categorias" class="btn btn-secondary">Cancelar</a>
        </EditForm>
    </div>
</div>

@code {
    private Categoria categoria = new Categoria();
    private List<Categoria> listaExistentes = new();

    protected override async Task OnInitializedAsync()
    {
        // Carrega lista para o dropdown
        listaExistentes = await Context.Categorias.ToListAsync();
    }

    private async Task GuardarCategoria()
    {
        Context.Categorias.Add(categoria);
        await Context.SaveChangesAsync();
        Navigation.NavigateTo("/categorias");
    }
}