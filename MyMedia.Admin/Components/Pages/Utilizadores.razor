@page "/utilizadores"
@using Microsoft.AspNetCore.Identity
@using MyMedia.Data.Entities
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize(Roles = "Administrador, Funcionario")]

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<h3>Gestão de Utilizadores</h3>

@if (listaUtilizadores == null)
{
    <div class="alert alert-info">A carregar utilizadores...</div>
}
else
{
    <table class="table table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Nome / Email</th>
                <th>NIF</th>
                <th>Estado</th>
                <th>Função</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in listaUtilizadores)
            {
                // 1. Descobrir a Role
                var roleDesteUser = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : "Cliente";

                // 2. Lógica de Segurança (Quem pode mexer em quem?)
                bool podeEditar = true;

                // A: Não posso mexer em mim próprio
                if (user.Id == currentUserId) podeEditar = false;

                // B: Funcionários não mexem em Admins
                if (!isAdmin && roleDesteUser == "Administrador") podeEditar = false;

                <tr>
                    <td>
                        <div class="fw-bold">@user.NomeCompleto</div>
                        <small class="text-muted">@user.Email</small>
                    </td>
                    <td>@user.NIF</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pendente/Suspenso</span>
                        }
                    </td>
                    <td>
                        <span class="badge bg-info text-dark">@roleDesteUser</span>
                    </td>
                    <td>
                        @if (podeEditar)
                        {
                            <div class="dropdown position-relative">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                        @onclick="() => ToggleDropdown(user.Id)"
                                        @onclick:stopPropagation>
                                    Gerir
                                </button>

                                <ul class="dropdown-menu @(dropdownAbertoId == user.Id ? "show" : "")"
                                    style="right: 0; left: auto; z-index: 1050;">

                                    @* 1. ESTADO (Ativar/Suspender) *@
                                    <li>
                                        <button class="dropdown-item" @onclick="() => ToggleEstado(user)">
                                            @if (user.IsActive)
                                            {
                                                <span><i class="bi bi-pause-circle me-2"></i>Suspender</span>
                                            }
                                            else
                                            {
                                                <span><i class="bi bi-check-circle me-2"></i>Aprovar/Ativar</span>
                                            }
                                        </button>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    @* 2. MUDANÇA DE ROLES (Apenas Admin vê isto) *@
                                    @if (isAdmin)
                                    {
                                        <li>
                                            <h6 class="dropdown-header">Mudar Função</h6>
                                        </li>
                                        <li>
                                            <button class="dropdown-item" @onclick="@(() => MudarRole(user, "Funcionario"))">
                                                Promover a Funcionário
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item" @onclick="@(() => MudarRole(user, "Fornecedor"))">
                                                Mudar para Fornecedor
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item" @onclick="@(() => MudarRole(user, "Cliente"))">
                                                Despromover a Cliente
                                            </button>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }

                                    @* 3. APAGAR *@
                                    <li>
                                        <button class="dropdown-item text-danger" @onclick="@(() => ApagarUser(user))">
                                            <i class="bi bi-trash me-2"></i>Apagar Conta
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        }
                        else if (user.Id == currentUserId)
                        {
                            <span class="text-muted fst-italic small">(És tu)</span>
                        }
                        else
                        {
                            <span class="text-muted small"><i class="bi bi-lock-fill"></i> Protegido</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ApplicationUser>? listaUtilizadores;
    private Dictionary<string, string> userRoles = new();
    private string currentUserId = "";
    private bool isAdmin = false;

    // Controla qual dropdown está aberto
    private string? dropdownAbertoId = null;

    protected override async Task OnInitializedAsync()
    {
        // 1. Quem sou eu?
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        isAdmin = user.IsInRole("Administrador");

        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        listaUtilizadores = await UserManager.Users.ToListAsync();
        userRoles.Clear();

        foreach (var u in listaUtilizadores)
        {
            var roles = await UserManager.GetRolesAsync(u);
            userRoles.Add(u.Id, roles.FirstOrDefault() ?? "Cliente");
        }
    }

    // Abre/Fecha o menu de um user específico
    private void ToggleDropdown(string userId)
    {
        if (dropdownAbertoId == userId) dropdownAbertoId = null; // Fecha se já estiver aberto
        else dropdownAbertoId = userId; // Abre o novo
    }

    private async Task ToggleEstado(ApplicationUser user)
    {
        user.IsActive = !user.IsActive;
        await UserManager.UpdateAsync(user);
        dropdownAbertoId = null; // Fecha menu
    }

    private async Task MudarRole(ApplicationUser user, string novaRole)
    {
        var rolesAtuais = await UserManager.GetRolesAsync(user);
        if (rolesAtuais.Any())
        {
            await UserManager.RemoveFromRolesAsync(user, rolesAtuais);
        }
        await UserManager.AddToRoleAsync(user, novaRole);

        dropdownAbertoId = null;
        await CarregarDados(); // Recarrega para atualizar a tabela visualmente
    }

    private async Task ApagarUser(ApplicationUser user)
    {
        await UserManager.DeleteAsync(user);
        dropdownAbertoId = null;
        await CarregarDados();
    }
}